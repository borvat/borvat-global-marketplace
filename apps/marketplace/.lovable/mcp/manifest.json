            },
            "status": {
              "type": "string",
              "enum": [
                "processing",
                "shipped",
                "delivered",
                "cancelled"
              ]
            },
            "tracking_carrier": {
              "type": "string",
              "maxLength": 50
            },
            "tracking_code": {
              "type": "string",
              "maxLength": 100
            },
            "tracking_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "order_item_id",
            "status"
          ]
        },
        "outputSchema": null
