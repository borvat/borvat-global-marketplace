      {
        "name": "recommend_price",
        "title": "Prijs-aanbeveling (verkoper)",
        "description": "Analyseert markt + kosten en stelt een prijs voor. Vereist purchase_cost_cents en minimum_margin_pct. Geeft `missing_cost_data` terug als kosten ontbreken. Wordt NIET toegepast — alleen als suggestie opgeslagen.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "purchase_cost_cents": {
              "description": "Inkoopprijs per stuk in centen",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "shipping_cost_cents": {
              "description": "Verzendkosten per stuk in centen",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "marketplace_fee_pct": {
              "description": "Marketplace commissie (%)",
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "vat_pct": {
              "description": "BTW-percentage; default 21 (NL)",
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "minimum_margin_pct": {
              "description": "Gewenste netto marge (%)",
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "reasoning": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "product_id"
          ]
        },
        "outputSchema": null
