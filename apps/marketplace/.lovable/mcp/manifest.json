      {
        "name": "create_product_draft",
        "title": "Product-concept maken (verkoper)",
        "description": "Maakt een CONCEPT-product voor de ingelogde verkoper. Het product is NIET zichtbaar in de winkel totdat de verkoper het publiceert via het dashboard. Prijs in centen.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3
            },
            "price_cents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "stock": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": {
              "type": "string"
            },
            "image_url": {
              "type": "string",
              "format": "uri"
            },
            "category_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "title",
            "price_cents",
            "stock"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "suggest_product_content",
        "title": "Content-suggestie (verkoper)",
        "description": "Maakt een suggestie (draft) voor betere titel of beschrijving voor een van jouw producten. Wordt NIET automatisch toegepast — de verkoper moet accepteren via het dashboard.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
