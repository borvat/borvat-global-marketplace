onents","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":42,"column":18,"nodeType":"Identifier","messageId":"namedExport","endLine":42,"endColumn":32}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from \"react\";\nimport * as TogglePrimitive from \"@radix-ui/react-toggle\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\n\nimport { cn } from \"@/lib/utils\";\n\nconst toggleVariants = cva(\n  \"inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium cursor-pointer transition-colors hover:bg-muted hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 disabled:cursor-not-allowed data-[state=on]:bg-accent data-[state=on]:text-accent-foreground [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0\",\n  {\n    variants: {\n      variant: {\n        default: \"bg-transparent\",\n        outline:\n          \"border border-input bg-transparent shadow-sm hover:bg-accent hover:text-accent-foreground\",\n      },\n      size: {\n        default: \"h-9 px-2 min-w-9\",\n        sm: \"h-8 px-1.5 min-w-8\",\n        lg: \"h-10 px-2.5 min-w-10\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n      size: \"default\",\n    },\n  },\n);\n\nconst Toggle = React.forwardRef<\n  React.ElementRef<typeof TogglePrimitive.Root>,\n  React.ComponentPropsWithoutRef<typeof TogglePrimitive.Root> & VariantProps<typeof toggleVariants>\n>(({ className, variant, size, ...props }, ref) => (\n  <TogglePrimitive.Root\n    ref={ref}\n    className={cn(toggleVariants({ variant, size, className }))}\n    {...props}\n  />\n));\n\nToggle.displayName = TogglePrimitive.Root.displayName;\n\nexport { Toggle, toggleVariants };\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/ui/tooltip.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/demo/companies.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/demo/messages.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/demo/ops.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/demo/products.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/demo/quotes.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/demo/shipping.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/hooks/use-mobile.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/hooks/useSellerApplication.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/hooks/useSellerData.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/integrations/lovable/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/integrations/supabase/auth-attacher.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/integrations/supabase/auth-middleware.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/integrations/supabase/client.server.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/integrations/supabase/client.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/integrations/supabase/previewAuthStorage.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/integrations/supabase/types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/admin/ui.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":6,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":6,"endColumn":31},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":104,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":104,"endColumn":24},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":112,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":112,"endColumn":30}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nexport const STATUS_OPTIONS = [\"\", \"draft\", \"active\", \"inactive\", \"archived\"] as const;\nexport type StatusFilter = (typeof STATUS_OPTIONS)[number];\n\nexport function useCursorStack() {\n  const [stack, setStack] = useState<Array<{ created_at: string; id: string } | null>>([null]);\n  const current = stack[stack.length - 1];\n  const push = (c: { created_at: string; id: string }) => setStack((s) => [...s, c]);\n  const back = () => setStack((s) => (s.length > 1 ? s.slice(0, -1) : s));\n  const reset = () => setStack([null]);\n  return { current, push, back, reset, canBack: stack.length > 1 };\n}\n\nexport function Toolbar({\n  search,\n  setSearch,\n  status,\n  setStatus,\n  onApply,\n}: {\n  search: string;\n  setSearch: (v: string) => void;\n  status: StatusFilter;\n  setStatus: (v: StatusFilter) => void;\n  onApply: () => void;\n}) {\n  return (\n    <form\n      className=\"flex flex-wrap gap-2 mb-3\"\n      onSubmit={(e) => {\n        e.preventDefault();\n        onApply();\n      }}\n    >\n      <input\n        type=\"text\"\n        maxLength={100}\n        placeholder=\"Search (company, store, slug…)\"\n        value={search}\n        onChange={(e) => setSearch(e.target.value)}\n        className=\"px-3 py-2 text-sm border border-border rounded bg-background flex-1 min-w-[200px]\"\n      />\n      <select\n        value={status}\n        onChange={(e) => setStatus(e.target.value as StatusFilter)}\n        className=\"px-3 py-2 text-sm border border-border rounded bg-background\"\n      >\n        <option value=\"\">All statuses</option>\n        <option value=\"draft\">Draft</option>\n        <option value=\"active\">Active</option>\n        <option value=\"inactive\">Inactive</option>\n        <option value=\"archived\">Archived</option>\n      </select>\n      <button\n        type=\"submit\"\n        className=\"px-3 py-2 text-sm rounded bg-foreground text-background hover:opacity-90\"\n      >\n        Apply\n      </button>\n    </form>\n  );\n}\n\nexport function Pager({\n  canBack,\n  hasMore,\n  onBack,\n  onNext,\n}: {\n  canBack: boolean;\n  hasMore: boolean;\n  onBack: () => void;\n  onNext: () => void;\n}) {\n  return (\n    <div className=\"flex justify-end gap-2 mt-3\">\n      <button\n        onClick={onBack}\n        disabled={!canBack}\n        className=\"px-3 py-1.5 text-sm rounded border border-border disabled:opacity-40\"\n      >\n        Previous\n      </button>\n      <button\n        onClick={onNext}\n        disabled={!hasMore}\n        className=\"px-3 py-1.5 text-sm rounded border border-border disabled:opacity-40\"\n      >\n        Next\n      </button>\n    </div>\n  );\n}\n\nexport function StatusPill({ value }: { value: string }) {\n  return (\n    <span className=\"inline-flex items-center rounded px-2 py-0.5 text-xs font-medium bg-muted text-muted-foreground border border-border\">\n      {value}\n    </span>\n  );\n}\n\nexport function fmtDate(iso: string) {\n  try {\n    return new Date(iso).toISOString().slice(0, 10);\n  } catch {\n    return iso;\n  }\n}\n\nexport function friendlyError(err: unknown): string {\n  const msg = (err as { message?: string } | null)?.message ?? \"\";\n  if (msg.includes(\"not_authenticated\")) return \"Session expired. Please sign in again.\";\n  if (msg.includes(\"not_platform_admin\") || msg.includes(\"insufficient_privilege\"))\n    return \"Access denied.\";\n  if (msg.includes(\"search_too_long\")) return \"Search must be 100 characters or fewer.\";\n  if (msg.includes(\"invalid_status_filter\")) return \"Invalid status filter.\";\n  if (msg.includes(\"invalid_cursor\")) return \"Invalid pagination cursor.\";\n  return \"Read failed.\";\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/buyer-account.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/_brand.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/_layout.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":63,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":63,"endColumn":25}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from \"react\";\nimport {\n  Body,\n  Container,\n  Head,\n  Html,\n  Img,\n  Preview,\n  Section,\n  Hr,\n  Text,\n} from \"@react-email/components\";\nimport { brandLogoUrl } from \"./_brand\";\n\ninterface Props {\n  siteName: string;\n  siteUrl: string;\n  previewText: string;\n  children: React.ReactNode;\n}\n\nexport const BrandedEmail = ({ siteName, siteUrl, previewText, children }: Props) => (\n  <Html lang=\"nl\" dir=\"ltr\">\n    <Head />\n    <Preview>{previewText}</Preview>\n    <Body style={main}>\n      <Container style={container}>\n        <Section style={header}>\n          <Img\n            src={brandLogoUrl(siteUrl)}\n            alt={siteName}\n            width=\"140\"\n            style={{ display: \"block\" }}\n          />\n        </Section>\n        <Section style={card}>{children}</Section>\n        <Hr style={hr} />\n        <Text style={footer}>\n          © {new Date().getFullYear()} Borvat® — Smart living, made affordable.\n        </Text>\n      </Container>\n    </Body>\n  </Html>\n);\n\nconst main = {\n  backgroundColor: \"#ffffff\",\n  fontFamily: \"Arial, Helvetica, sans-serif\",\n  margin: 0,\n  padding: \"24px 0\",\n};\nconst container = { maxWidth: \"560px\", margin: \"0 auto\", padding: \"0 16px\" };\nconst header = { padding: \"8px 4px 20px\" };\nconst card = {\n  border: \"1px solid #eeeeee\",\n  borderRadius: \"10px\",\n  padding: \"28px 28px 24px\",\n  backgroundColor: \"#ffffff\",\n};\nconst hr = { borderColor: \"#eeeeee\", margin: \"24px 0 12px\" };\nconst footer = { fontSize: \"11px\", color: \"#8a8a8a\", textAlign: \"center\" as const, margin: 0 };\n\nexport const emailStyles = {\n  h1: { fontSize: \"22px\", fontWeight: \"bold\" as const, color: \"#0a0a0a\", margin: \"0 0 16px\" },\n  text: { fontSize: \"14px\", color: \"#3f3f46\", lineHeight: \"1.6\", margin: \"0 0 18px\" },\n  button: {\n    backgroundColor: \"#dc2626\",\n    color: \"#ffffff\",\n    fontSize: \"14px\",\n    fontWeight: \"bold\" as const,\n    borderRadius: \"6px\",\n    padding: \"12px 22px\",\n    textDecoration: \"none\",\n    display: \"inline-block\",\n  },\n  small: { fontSize: \"12px\", color: \"#71717a\", margin: \"20px 0 0\", lineHeight: \"1.5\" },\n  link: { color: \"#dc2626\", textDecoration: \"underline\" },\n  code: {\n    display: \"inline-block\",\n    padding: \"10px 18px\",\n    fontSize: \"20px\",\n    letterSpacing: \"4px\",\n    fontWeight: \"bold\" as const,\n    backgroundColor: \"#f4f4f5\",\n    borderRadius: \"6px\",\n    color: \"#0a0a0a\",\n  },\n};\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/email-change.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/invite.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/magic-link.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/order-delivered.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Move your component(s) to a separate file.","line":19,"column":7,"nodeType":"Identifier","messageId":"localComponents","endLine":19,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from \"react\";\nimport { Button, Column, Heading, Hr, Row, Section, Text } from \"@react-email/components\";\nimport { BrandedEmail, emailStyles } from \"./_layout\";\nimport type { TemplateEntry } from \"./registry\";\n\ninterface OrderItem {\n  title: string;\n  quantity: number;\n}\n\ninterface Props {\n  siteUrl: string;\n  orderNumber: string;\n  customerName: string;\n  items: OrderItem[];\n  orderTotal: string;\n}\n\nconst Email = ({ siteUrl, orderNumber, customerName, items, orderTotal }: Props) => (\n  <BrandedEmail\n    siteName=\"Borvat\"\n    siteUrl={siteUrl}\n    previewText={`Je bestelling ${orderNumber} is geleverd`}\n  >\n    <Heading style={emailStyles.h1}>Je pakket is bezorgd</Heading>\n    <Text style={emailStyles.text}>Hoi {customerName},</Text>\n    <Text style={emailStyles.text}>\n      Bestelling <strong>{orderNumber}</strong> is geleverd. Geniet van je aankoop!\n    </Text>\n    <Text style={emailStyles.text}>\n      Huidige status: <strong>Geleverd</strong>.\n    </Text>\n\n    <Section style={summary}>\n      {items.map((item, idx) => (\n        <Row key={idx} style={row}>\n          <Column>\n            <Text style={{ ...emailStyles.text, margin: 0, fontWeight: \"bold\" }}>{item.title}</Text>\n            <Text style={{ ...emailStyles.text, margin: 0, fontSize: \"12px\", color: \"#71717a\" }}>\n              {item.quantity} stuk(s)\n            </Text>\n          </Column>\n        </Row>\n      ))}\n      <Hr style={hr} />\n      <Text style={{ ...emailStyles.text, margin: 0, fontWeight: \"bold\" }}>\n        Totaal: {orderTotal}\n      </Text>\n    </Section>\n\n    <Section style={{ textAlign: \"center\" as const, marginTop: \"24px\" }}>\n      <Button href={`${siteUrl.replace(/\\/$/, \"\")}/orders`} style={emailStyles.button}>\n        Bekijk je bestelling\n      </Button>\n    </Section>\n\n    <Text style={emailStyles.small}>\n      Iets niet in orde? Neem contact op met de verkoper via je bestellingenpagina.\n    </Text>\n  </BrandedEmail>\n);\n\nexport const template = {\n  component: Email,\n  subject: (data: Record<string, unknown>) =>\n    `Borvat — Je bestelling ${data.orderNumber} is geleverd`,\n\n  displayName: \"Orderstatus: geleverd\",\n  previewData: {\n    siteUrl: \"https://borvatshop.com\",\n    orderNumber: \"ORD-2026-1234\",\n    customerName: \"Jan\",\n    items: [{ title: \"Slimme WiFi-lamp\", quantity: 2 }],\n    orderTotal: \"€ 49,98\",\n  },\n} satisfies TemplateEntry<Props>;\n\nconst summary = {\n  border: \"1px solid #eeeeee\",\n  borderRadius: \"8px\",\n  padding: \"16px\",\n  marginTop: \"16px\",\n  backgroundColor: \"#fafafa\",\n};\nconst row = { marginBottom: \"8px\" };\nconst hr = { borderColor: \"#e4e4e7\", margin: \"12px 0\" };\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/order-processing.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Move your component(s) to a separate file.","line":19,"column":7,"nodeType":"Identifier","messageId":"localComponents","endLine":19,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from \"react\";\nimport { Button, Column, Heading, Hr, Row, Section, Text } from \"@react-email/components\";\nimport { BrandedEmail, emailStyles } from \"./_layout\";\nimport type { TemplateEntry } from \"./registry\";\n\ninterface OrderItem {\n  title: string;\n  quantity: number;\n}\n\ninterface Props {\n  siteUrl: string;\n  orderNumber: string;\n  customerName: string;\n  items: OrderItem[];\n  orderTotal: string;\n}\n\nconst Email = ({ siteUrl, orderNumber, customerName, items, orderTotal }: Props) => (\n  <BrandedEmail\n    siteName=\"Borvat\"\n    siteUrl={siteUrl}\n    previewText={`Je bestelling ${orderNumber} is in verwerking`}\n  >\n    <Heading style={emailStyles.h1}>Bestelling in verwerking</Heading>\n    <Text style={emailStyles.text}>Hoi {customerName},</Text>\n    <Text style={emailStyles.text}>\n      We hebben je betaling voor bestelling <strong>{orderNumber}</strong> ontvangen. We gaan je\n      bestelling nu voor je klaarmaken.\n    </Text>\n    <Text style={emailStyles.text}>\n      Huidige status: <strong>In verwerking</strong>.\n    </Text>\n\n    <Section style={summary}>\n      {items.map((item, idx) => (\n        <Row key={idx} style={row}>\n          <Column>\n            <Text style={{ ...emailStyles.text, margin: 0, fontWeight: \"bold\" }}>{item.title}</Text>\n            <Text style={{ ...emailStyles.text, margin: 0, fontSize: \"12px\", color: \"#71717a\" }}>\n              {item.quantity} stuk(s)\n            </Text>\n          </Column>\n        </Row>\n      ))}\n      <Hr style={hr} />\n      <Text style={{ ...emailStyles.text, margin: 0, fontWeight: \"bold\" }}>\n        Totaal: {orderTotal}\n      </Text>\n    </Section>\n\n    <Section style={{ textAlign: \"center\" as const, marginTop: \"24px\" }}>\n      <Button href={`${siteUrl.replace(/\\/$/, \"\")}/orders`} style={emailStyles.button}>\n        Bekijk je bestelling\n      </Button>\n    </Section>\n\n    <Text style={emailStyles.small}>\n      Je ontvangt automatisch een e-mail zodra je pakket wordt verzonden.\n    </Text>\n  </BrandedEmail>\n);\n\nexport const template = {\n  component: Email,\n  subject: (data: Record<string, unknown>) =>\n    `Borvat — Je bestelling ${data.orderNumber} is in verwerking`,\n\n  displayName: \"Orderstatus: in verwerking\",\n  previewData: {\n    siteUrl: \"https://borvatshop.com\",\n    orderNumber: \"ORD-2026-1234\",\n    customerName: \"Jan\",\n    items: [{ title: \"Slimme WiFi-lamp\", quantity: 2 }],\n    orderTotal: \"€ 49,98\",\n  },\n} satisfies TemplateEntry<Props>;\n\nconst summary = {\n  border: \"1px solid #eeeeee\",\n  borderRadius: \"8px\",\n  padding: \"16px\",\n  marginTop: \"16px\",\n  backgroundColor: \"#fafafa\",\n};\nconst row = { marginBottom: \"8px\" };\nconst hr = { borderColor: \"#e4e4e7\", margin: \"12px 0\" };\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/order-shipped.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Move your component(s) to a separate file.","line":22,"column":7,"nodeType":"Identifier","messageId":"localComponents","endLine":22,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from \"react\";\nimport { Button, Column, Heading, Hr, Link, Row, Section, Text } from \"@react-email/components\";\nimport { BrandedEmail, emailStyles } from \"./_layout\";\nimport type { TemplateEntry } from \"./registry\";\n\ninterface OrderItem {\n  title: string;\n  quantity: number;\n}\n\ninterface Props {\n  siteUrl: string;\n  orderNumber: string;\n  customerName: string;\n  items: OrderItem[];\n  orderTotal: string;\n  trackingCarrier: string;\n  trackingCode: string;\n  trackingUrl?: string;\n}\n\nconst Email = ({\n  siteUrl,\n  orderNumber,\n  customerName,\n  items,\n  orderTotal,\n  trackingCarrier,\n  trackingCode,\n  trackingUrl,\n}: Props) => (\n  <BrandedEmail\n    siteName=\"Borvat\"\n    siteUrl={siteUrl}\n    previewText={`Je bestelling ${orderNumber} is verzonden`}\n  >\n    <Heading style={emailStyles.h1}>Je pakket is onderweg</Heading>\n    <Text style={emailStyles.text}>Hoi {customerName},</Text>\n    <Text style={emailStyles.text}>\n      Bestelling <strong>{orderNumber}</strong> is verzonden. Je pakket is nu onderweg naar het\n      bezorgadres.\n    </Text>\n    <Text style={emailStyles.text}>\n      Huidige status: <strong>Verzonden</strong>.\n    </Text>\n\n    <Section style={trackingBox}>\n      <Text style={{ ...emailStyles.text, margin: 0, fontWeight: \"bold\" }}>Track & trace</Text>\n      <Text style={{ ...emailStyles.text, margin: \"4px 0 0\" }}>\n        {trackingCarrier} · {trackingCode}\n      </Text>\n      {trackingUrl && (\n        <Section style={{ marginTop: \"12px\" }}>\n          <Link href={trackingUrl} style={emailStyles.button}>\n            Volg mijn pakket\n          </Link>\n        </Section>\n      )}\n    </Section>\n\n    <Section style={summary}>\n      {items.map((item, idx) => (\n        <Row key={idx} style={row}>\n          <Column>\n            <Text style={{ ...emailStyles.text, margin: 0, fontWeight: \"bold\" }}>{item.title}</Text>\n            <Text style={{ ...emailStyles.text, margin: 0, fontSize: \"12px\", color: \"#71717a\" }}>\n              {item.quantity} stuk(s)\n            </Text>\n          </Column>\n        </Row>\n      ))}\n      <Hr style={hr} />\n      <Text style={{ ...emailStyles.text, margin: 0, fontWeight: \"bold\" }}>\n        Totaal: {orderTotal}\n      </Text>\n    </Section>\n\n    <Section style={{ textAlign: \"center\" as const, marginTop: \"24px\" }}>\n      <Button href={`${siteUrl.replace(/\\/$/, \"\")}/orders`} style={emailStyles.button}>\n        Bekijk je bestelling\n      </Button>\n    </Section>\n\n    <Text style={emailStyles.small}>\n      Geen track & trace-link zichtbaar? Soms duurt het een paar uur voordat het vervoerder de\n      zending registreert.\n    </Text>\n  </BrandedEmail>\n);\n\nexport const template = {\n  component: Email,\n  subject: (data: Record<string, unknown>) =>\n    `Borvat — Je bestelling ${data.orderNumber} is verzonden`,\n\n  displayName: \"Orderstatus: verzonden\",\n  previewData: {\n    siteUrl: \"https://borvatshop.com\",\n    orderNumber: \"ORD-2026-1234\",\n    customerName: \"Jan\",\n    items: [{ title: \"Slimme WiFi-lamp\", quantity: 2 }],\n    orderTotal: \"€ 49,98\",\n    trackingCarrier: \"PostNL\",\n    trackingCode: \"3SBXYZ1234567\",\n    trackingUrl: \"https://postnl.nl/tracktrace/?B=3SBXYZ1234567\",\n  },\n} satisfies TemplateEntry<Props>;\n\nconst trackingBox = {\n  border: \"1px solid #eeeeee\",\n  borderRadius: \"8px\",\n  padding: \"16px\",\n  marginTop: \"16px\",\n  backgroundColor: \"#fafafa\",\n};\nconst summary = {\n  border: \"1px solid #eeeeee\",\n  borderRadius: \"8px\",\n  padding: \"16px\",\n  marginTop: \"16px\",\n  backgroundColor: \"#fafafa\",\n};\nconst row = { marginBottom: \"8px\" };\nconst hr = { borderColor: \"#e4e4e7\", margin: \"12px 0\" };\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/reauthentication.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/lib/email-templates/recovery.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCo