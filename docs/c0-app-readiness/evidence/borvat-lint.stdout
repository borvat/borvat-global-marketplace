ion/critical-path/borvat-typed/src/routes/_authenticated/account.support.index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/account.support.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/audit.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/channels.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'cursor'. Either include it or remove the dependency array. Mutable values like 'cursor.current' aren't valid dependencies because mutating them doesn't re-render the component.","line":74,"column":6,"nodeType":"ArrayExpression","endLine":74,"endColumn":31,"suggestions":[{"desc":"Update the dependencies array to be: [applied, cursor]","fix":{"range":[2064,2089],"text":"[applied, cursor]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { createFileRoute } from \"@tanstack/react-router\";\nimport { useEffect, useState } from \"react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport {\n  Toolbar,\n  Pager,\n  StatusPill,\n  fmtDate,\n  friendlyError,\n  useCursorStack,\n  type StatusFilter,\n} from \"@/lib/admin/ui\";\n\nexport const Route = createFileRoute(\"/_authenticated/admin/channels\")({\n  component: AdminChannels,\n});\n\nconst PAGE_SIZE = 25;\n\ntype Row = {\n  company_id: string;\n  company_name: string;\n  merchant_store_id: string;\n  store_name: string;\n  channel_account_id: string;\n  provider: string;\n  display_name: string;\n  status: string;\n  control_state: string;\n  created_at: string;\n  updated_at: string;\n};\n\nfunction AdminChannels() {\n  const [rows, setRows] = useState<Row[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [hasMore, setHasMore] = useState(false);\n  const [search, setSearch] = useState(\"\");\n  const [status, setStatus] = useState<StatusFilter>(\"\");\n  const [applied, setApplied] = useState({ search: \"\", status: \"\" as StatusFilter });\n  const cursor = useCursorStack();\n\n  useEffect(() => {\n    let cancelled = false;\n    (async () => {\n      setLoading(true);\n      setError(null);\n      const c = cursor.current;\n      const { data, error } = await supabase.rpc(\"admin_list_borvat_direct_accounts\", {\n        _page_size: PAGE_SIZE,\n        _after_created_at: c?.created_at ?? undefined,\n        _after_id: c?.id ?? undefined,\n        _search: applied.search.trim() || undefined,\n        _status: applied.status || undefined,\n      });\n      if (cancelled) return;\n      if (error) {\n        setRows([]);\n        setHasMore(false);\n        setError(friendlyError(error));\n        setLoading(false);\n        return;\n      }\n      const list = (data ?? []) as Row[];\n      const more = list.length > PAGE_SIZE;\n      setRows(more ? list.slice(0, PAGE_SIZE) : list);\n      setHasMore(more);\n      setLoading(false);\n    })();\n    return () => {\n      cancelled = true;\n    };\n  }, [applied, cursor.current]);\n\n  return (\n    <div>\n      <Toolbar\n        search={search}\n        setSearch={setSearch}\n        status={status}\n        setStatus={setStatus}\n        onApply={() => {\n          cursor.reset();\n          setApplied({ search, status });\n        }}\n      />\n\n      {error && (\n        <div className=\"bg-card border border-border rounded p-6 text-center\">\n          <div className=\"font-medium\">{error}</div>\n        </div>\n      )}\n\n      {!error && (\n        <div className=\"bg-card border border-border rounded overflow-hidden\">\n          <table className=\"w-full text-sm\">\n            <thead className=\"bg-muted/40\">\n              <tr className=\"text-left\">\n                <th className=\"px-3 py-2\">Company</th>\n                <th className=\"px-3 py-2\">Store</th>\n                <th className=\"px-3 py-2\">Account</th>\n                <th className=\"px-3 py-2\">Provider</th>\n                <th className=\"px-3 py-2\">Status</th>\n                <th className=\"px-3 py-2\">Control state</th>\n                <th className=\"px-3 py-2\">Created</th>\n              </tr>\n            </thead>\n            <tbody>\n              {loading && (\n                <tr>\n                  <td colSpan={7} className=\"px-3 py-6 text-center text-muted-foreground\">\n                    Loading…\n                  </td>\n                </tr>\n              )}\n              {!loading && rows.length === 0 && (\n                <tr>\n                  <td colSpan={7} className=\"px-3 py-6 text-center text-muted-foreground\">\n                    No results.\n                  </td>\n                </tr>\n              )}\n              {!loading &&\n                rows.map((r) => (\n                  <tr key={r.channel_account_id} className=\"border-t border-border\">\n                    <td className=\"px-3 py-2 font-medium\">{r.company_name}</td>\n                    <td className=\"px-3 py-2\">{r.store_name}</td>\n                    <td className=\"px-3 py-2\">{r.display_name}</td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">{r.provider}</td>\n                    <td className=\"px-3 py-2\">\n                      <StatusPill value={r.status} />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <span className=\"inline-flex items-center rounded px-2 py-0.5 text-xs bg-amber-50 text-amber-800 border border-amber-200\">\n                        {r.control_state}\n                      </span>\n                    </td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">{fmtDate(r.created_at)}</td>\n                  </tr>\n                ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {!error && (\n        <Pager\n          canBack={cursor.canBack}\n          hasMore={hasMore}\n          onBack={cursor.back}\n          onNext={() => {\n            const last = rows[rows.length - 1];\n            if (last) cursor.push({ created_at: last.created_at, id: last.channel_account_id });\n          }}\n        />\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/companies.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/dashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/health.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/listings.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'cursor'. Either include it or remove the dependency array. Mutable values like 'cursor.current' aren't valid dependencies because mutating them doesn't re-render the component.","line":79,"column":6,"nodeType":"ArrayExpression","endLine":79,"endColumn":31,"suggestions":[{"desc":"Update the dependencies array to be: [applied, cursor]","fix":{"range":[2188,2213],"text":"[applied, cursor]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { createFileRoute } from \"@tanstack/react-router\";\nimport { useEffect, useState } from \"react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport {\n  Toolbar,\n  Pager,\n  StatusPill,\n  fmtDate,\n  friendlyError,\n  useCursorStack,\n  type StatusFilter,\n} from \"@/lib/admin/ui\";\n\nexport const Route = createFileRoute(\"/_authenticated/admin/listings\")({\n  component: AdminListings,\n});\n\nconst PAGE_SIZE = 25;\n\ntype Row = {\n  company_id: string;\n  company_name: string;\n  merchant_store_id: string;\n  store_name: string;\n  channel_account_id: string;\n  listing_id: string;\n  sku_id: string;\n  sku_code: string;\n  product_id: string;\n  product_title: string;\n  brand: string;\n  listing_status: string;\n  control_state: string;\n  published_quantity: number;\n  created_at: string;\n  updated_at: string;\n};\n\nfunction AdminListings() {\n  const [rows, setRows] = useState<Row[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [hasMore, setHasMore] = useState(false);\n  const [search, setSearch] = useState(\"\");\n  const [status, setStatus] = useState<StatusFilter>(\"\");\n  const [applied, setApplied] = useState({ search: \"\", status: \"\" as StatusFilter });\n  const cursor = useCursorStack();\n\n  useEffect(() => {\n    let cancelled = false;\n    (async () => {\n      setLoading(true);\n      setError(null);\n      const c = cursor.current;\n      const { data, error } = await supabase.rpc(\"admin_list_borvat_direct_draft_listings\", {\n        _page_size: PAGE_SIZE,\n        _after_created_at: c?.created_at ?? undefined,\n        _after_id: c?.id ?? undefined,\n        _search: applied.search.trim() || undefined,\n        _status: applied.status || undefined,\n      });\n      if (cancelled) return;\n      if (error) {\n        setRows([]);\n        setHasMore(false);\n        setError(friendlyError(error));\n        setLoading(false);\n        return;\n      }\n      const list = (data ?? []) as Row[];\n      const more = list.length > PAGE_SIZE;\n      setRows(more ? list.slice(0, PAGE_SIZE) : list);\n      setHasMore(more);\n      setLoading(false);\n    })();\n    return () => {\n      cancelled = true;\n    };\n  }, [applied, cursor.current]);\n\n  return (\n    <div>\n      <Toolbar\n        search={search}\n        setSearch={setSearch}\n        status={status}\n        setStatus={setStatus}\n        onApply={() => {\n          cursor.reset();\n          setApplied({ search, status });\n        }}\n      />\n\n      {error && (\n        <div className=\"bg-card border border-border rounded p-6 text-center\">\n          <div className=\"font-medium\">{error}</div>\n        </div>\n      )}\n\n      {!error && (\n        <div className=\"bg-card border border-border rounded overflow-x-auto\">\n          <table className=\"w-full text-sm\">\n            <thead className=\"bg-muted/40\">\n              <tr className=\"text-left\">\n                <th className=\"px-3 py-2\">Company</th>\n                <th className=\"px-3 py-2\">Store</th>\n                <th className=\"px-3 py-2\">SKU</th>\n                <th className=\"px-3 py-2\">Product</th>\n                <th className=\"px-3 py-2\">Brand</th>\n                <th className=\"px-3 py-2\">Status</th>\n                <th className=\"px-3 py-2\">Control</th>\n                <th className=\"px-3 py-2\">Qty (diag.)</th>\n                <th className=\"px-3 py-2\">Created</th>\n              </tr>\n            </thead>\n            <tbody>\n              {loading && (\n                <tr>\n                  <td colSpan={9} className=\"px-3 py-6 text-center text-muted-foreground\">\n                    Loading…\n                  </td>\n                </tr>\n              )}\n              {!loading && rows.length === 0 && (\n                <tr>\n                  <td colSpan={9} className=\"px-3 py-6 text-center text-muted-foreground\">\n                    No results.\n                  </td>\n                </tr>\n              )}\n              {!loading &&\n                rows.map((r) => (\n                  <tr key={r.listing_id} className=\"border-t border-border\">\n                    <td className=\"px-3 py-2 font-medium\">{r.company_name}</td>\n                    <td className=\"px-3 py-2\">{r.store_name}</td>\n                    <td className=\"px-3 py-2 font-mono text-xs\">{r.sku_code}</td>\n                    <td className=\"px-3 py-2\">{r.product_title}</td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">{r.brand}</td>\n                    <td className=\"px-3 py-2\">\n                      <StatusPill value={r.listing_status} />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <span className=\"inline-flex items-center rounded px-2 py-0.5 text-xs bg-amber-50 text-amber-800 border border-amber-200\">\n                        {r.control_state}\n                      </span>\n                    </td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">{r.published_quantity}</td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">{fmtDate(r.created_at)}</td>\n                  </tr>\n                ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {!error && (\n        <Pager\n          canBack={cursor.canBack}\n          hasMore={hasMore}\n          onBack={cursor.back}\n          onNext={() => {\n            const last = rows[rows.length - 1];\n            if (last) cursor.push({ created_at: last.created_at, id: last.listing_id });\n          }}\n        />\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/orders.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/products.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/quotes.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/route.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/security.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/seller-applications.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/shipping.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/stores.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'cursor'. Either include it or remove the dependency array. Mutable values like 'cursor.current' aren't valid dependencies because mutating them doesn't re-render the component.","line":76,"column":6,"nodeType":"ArrayExpression","endLine":76,"endColumn":31,"suggestions":[{"desc":"Update the dependencies array to be: [applied, cursor]","fix":{"range":[2042,2067],"text":"[applied, cursor]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { createFileRoute } from \"@tanstack/react-router\";\nimport { useEffect, useState } from \"react\";\nimport { supabase } from \"@/integrations/supabase/client\";\nimport {\n  Toolbar,\n  Pager,\n  StatusPill,\n  fmtDate,\n  friendlyError,\n  useCursorStack,\n  type StatusFilter,\n} from \"@/lib/admin/ui\";\n\nexport const Route = createFileRoute(\"/_authenticated/admin/stores\")({\n  component: AdminStores,\n});\n\nconst PAGE_SIZE = 25;\n\ntype Row = {\n  company_id: string;\n  company_name: string;\n  store_id: string;\n  display_name: string;\n  slug: string;\n  store_status: string;\n  is_primary: boolean;\n  country_code: string;\n  default_locale: string;\n  created_at: string;\n  updated_at: string;\n};\n\nfunction AdminStores() {\n  const [rows, setRows] = useState<Row[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [hasMore, setHasMore] = useState(false);\n\n  const [search, setSearch] = useState(\"\");\n  const [status, setStatus] = useState<StatusFilter>(\"\");\n  const [applied, setApplied] = useState({ search: \"\", status: \"\" as StatusFilter });\n\n  const cursor = useCursorStack();\n\n  useEffect(() => {\n    let cancelled = false;\n    (async () => {\n      setLoading(true);\n      setError(null);\n      const c = cursor.current;\n      const { data, error } = await supabase.rpc(\"admin_list_merchant_stores\", {\n        _page_size: PAGE_SIZE,\n        _after_created_at: c?.created_at ?? undefined,\n        _after_id: c?.id ?? undefined,\n        _search: applied.search.trim() || undefined,\n        _status: applied.status || undefined,\n      });\n      if (cancelled) return;\n      if (error) {\n        setRows([]);\n        setHasMore(false);\n        setError(friendlyError(error));\n        setLoading(false);\n        return;\n      }\n      const list = (data ?? []) as Row[];\n      const more = list.length > PAGE_SIZE;\n      setRows(more ? list.slice(0, PAGE_SIZE) : list);\n      setHasMore(more);\n      setLoading(false);\n    })();\n    return () => {\n      cancelled = true;\n    };\n  }, [applied, cursor.current]);\n\n  return (\n    <div>\n      <Toolbar\n        search={search}\n        setSearch={setSearch}\n        status={status}\n        setStatus={setStatus}\n        onApply={() => {\n          cursor.reset();\n          setApplied({ search, status });\n        }}\n      />\n\n      {error && (\n        <div className=\"bg-card border border-border rounded p-6 text-center\">\n          <div className=\"font-medium\">{error}</div>\n        </div>\n      )}\n\n      {!error && (\n        <div className=\"bg-card border border-border rounded overflow-hidden\">\n          <table className=\"w-full text-sm\">\n            <thead className=\"bg-muted/40\">\n              <tr className=\"text-left\">\n                <th className=\"px-3 py-2\">Company</th>\n                <th className=\"px-3 py-2\">Store</th>\n                <th className=\"px-3 py-2\">Slug</th>\n                <th className=\"px-3 py-2\">Status</th>\n                <th className=\"px-3 py-2\">Primary</th>\n                <th className=\"px-3 py-2\">Locale</th>\n                <th className=\"px-3 py-2\">Created</th>\n              </tr>\n            </thead>\n            <tbody>\n              {loading && (\n                <tr>\n                  <td colSpan={7} className=\"px-3 py-6 text-center text-muted-foreground\">\n                    Loading…\n                  </td>\n                </tr>\n              )}\n              {!loading && rows.length === 0 && (\n                <tr>\n                  <td colSpan={7} className=\"px-3 py-6 text-center text-muted-foreground\">\n                    No results.\n                  </td>\n                </tr>\n              )}\n              {!loading &&\n                rows.map((r) => (\n                  <tr key={r.store_id} className=\"border-t border-border\">\n                    <td className=\"px-3 py-2 font-medium\">{r.company_name}</td>\n                    <td className=\"px-3 py-2\">{r.display_name}</td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">{r.slug}</td>\n                    <td className=\"px-3 py-2\">\n                      <StatusPill value={r.store_status} />\n                    </td>\n                    <td className=\"px-3 py-2\">{r.is_primary ? \"Yes\" : \"—\"}</td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">\n                      {r.country_code} / {r.default_locale}\n                    </td>\n                    <td className=\"px-3 py-2 text-muted-foreground\">{fmtDate(r.created_at)}</td>\n                  </tr>\n                ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {!error && (\n        <Pager\n          canBack={cursor.canBack}\n          hasMore={hasMore}\n          onBack={cursor.back}\n          onNext={() => {\n            const last = rows[rows.length - 1];\n            if (last) cursor.push({ created_at: last.created_at, id: last.store_id });\n          }}\n        />\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/support.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/admin/users.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/checkout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/orders.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/owner-review.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/review/index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/review/route.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/review/seller-applications.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/route.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.advertising.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.analysis.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.catalog.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"The 'all' logical expression could make the dependencies of useMemo Hook (at line 90) change on every render. To fix this, wrap the initialization of 'all' in its own useMemo() Hook.","line":87,"column":9,"nodeType":"VariableDeclarator","endLine":87,"endColumn":33},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"The 'all' logical expression could make the dependencies of useMemo Hook (at line 103) change on every render. To fix this, wrap the initialization of 'all' in its own useMemo() Hook.","line":87,"column":9,"nodeType":"VariableDeclarator","endLine":87,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { createFileRoute } from \"@tanstack/react-router\";\nimport { useMemo, useState } from \"react\";\nimport {\n  ManagerShell,\n  SELLER_NAV,\n  DataTable,\n  Row,\n  Cell,\n  StatusBadge,\n  toneForStatus,\n  SearchInput,\n  FilterSelect,\n  Tabs,\n  Toolbar,\n  DemoAction,\n  Drawer,\n  KeyValue,\n  Pagination,\n  EmptyState,\n  Card,\n} from \"@/components/demo/shell\";\nimport { formatEur } from \"@/lib/format\";\nimport {\n  useActiveSellerWorkspace,\n  useSellerCatalog,\n  type SellerCatalogRow,\n} from \"@/hooks/useSellerData\";\n\nexport const Route = createFileRoute(\"/_authenticated/seller/catalog\")({\n  ssr: false,\n  head: () => ({\n    meta: [\n      { title: \"Products — Borvat Seller Manager\" },\n      {\n        name: \"description\",\n        content: \"Live read-only view of every listing, SKU, price and stock level in your shop.\",\n      },\n      { name: \"robots\", content: \"noindex\" },\n      { property: \"og:title\", content: \"Products — Borvat Seller Manager\" },\n      { property: \"og:description\", content: \"Live listings, price and stock.\" },\n    ],\n  }),\n  component: SellerCatalog,\n});\n\nconst TABS = [\n  { id: \"all\", label: \"All\" },\n  { id: \"for_sale\", label: \"For sale\" },\n  { id: \"not_for_sale\", label: \"Not for sale\" },\n  { id: \"no_stock\", label: \"No stock\" },\n  { id: \"problems\", label: \"Action required\" },\n];\n\nconst PAGE_SIZE = 25;\n\nfunction isPublished(r: SellerCatalogRow) {\n  return (\n    (r.publication_status ?? r.product_status) === \"published\" || r.product_status === \"active\"\n  );\n}\n\nfunction matchTab(r: SellerCatalogRow, tab: string) {\n  switch (tab) {\n    case \"for_sale\":\n      return isPublished(r) && (r.available ?? 0) > 0;\n    case \"not_for_sale\":\n      return !isPublished(r) || (r.available ?? 0) === 0;\n    case \"no_stock\":\n      return (r.available ?? 0) === 0;\n    case \"problems\":\n      return Boolean(r.action_reason) && r.action_reason !== \"none\";\n    default:\n      return true;\n  }\n}\n\nfunction SellerCatalog() {\n  const { active, isLoading: wsLoading, error: wsError } = useActiveSellerWorkspace();\n  const catalog = useSellerCatalog(active?.company_id, active?.store_id, 500, 0);\n\n  const [tab, setTab] = useState(\"all\");\n  const [q, setQ] = useState(\"\");\n  const [status, setStatus] = useState(\"all\");\n  const [page, setPage] = useState(0);\n  const [selected, setSelected] = useState<SellerCatalogRow | null>(null);\n\n  const all = catalog.data ?? [];\n  const statuses = useMemo(\n    () => Array.from(new Set(all.map((r) => r.product_status).filter(Boolean) as string[])).sort(),\n    [all],\n  );\n\n  const rows = useMemo(() => {\n    const needle = q.trim().toLowerCase();\n    return all\n      .filter((r) => matchTab(r, tab))\n      .filter((r) => (status === \"all\" ? true : r.product_status === status))\n      .filter((r) =>\n        needle === \"\"\n          ? true\n          : `${r.title ?? \"\"} ${r.sku_code ?? \"\"} ${r.brand ?? \"\"}`.toLowerCase().includes(needle),\n      );\n  }, [all, tab, status, q]);\n\n  const pageRows = rows.slice(page * PAGE_SIZE, page * PAGE_SIZE + PAGE_SIZE);\n  const shopName = active?.store_name ?? active?.company_name ?? \"Seller Manager\";\n  const loading = wsLoading || catalog.isLoading;\n  const error = wsError ?? (catalog.error as Error | null);\n\n  return (\n    <ManagerShell\n      workspace=\"seller\"\n      navTitle=\"Seller Manager\"\n      shopName={shopName}\n      nav={SELLER_NAV}\n      classification=\"REAL READ-ONLY\"\n      title=\"Products\"\n      subtitle=\"Live listings from your Borvat catalog · read-only\"\n      tabs={\n        <Tabs\n          tabs={TABS}\n          active={tab}\n          onChange={(t) => {\n            setTab(t);\n            setPage(0);\n          }}\n        />\n      }\n      actions={<DemoAction label=\"Export CSV\" size=\"sm\" />}\n    >\n      {error ? (\n        <Card title=\"Data unavailable\">\n          <p className=\"text-[13px] text-muted-foreground\">{error.message}</p>\n        </Card>\n      ) : (\n        <>\n          <Toolbar>\n            <SearchInput\n              value={q}\n              onChange={(v) => {\n                setQ(v);\n                setPage(0);\n              }}\n              placeholder=\"Search title, SKU or brand…\"\n            />\n            <FilterSelect\n              label=\"Status\"\n              value={status}\n              onChange={(v) => {\n                setStatus(v);\n                setPage(0);\n              }}\n              options={[\n                { value: \"all\", label: \"All statuses\" },\n                ...statuses.map((s) => ({ value: s, label: s })),\n              ]}\n            />\n            <span className=\"text-[12px] text-muted-foreground\">\n              {loading ? \"Loading…\" : `${rows.length} of ${all.length} SKUs`}\n            </span>\n          </Toolbar>\n\n          {!loading && rows.length === 0 ? (\n            <EmptyState\n              title=\"No listings found\"\n              hint=\"No catalog rows match this filter for the selected shop.\"\n            />\n          ) : (\n            <DataTable\n              columns={[\n                \"SKU\",\n                \"Product\",\n                \"Brand\",\n                \"Status\",\n                \"Price\",\n                \"Available\",\n                \"Reserved\",\n                \"Action\",\n              ]}\n              minWidth={980}\n            >\n              {pageRows.map((r) => (\n                <Row key={r.sku_id} onClick={() => setSelected(r)}>\n                  <Cell className=\"font-mono text-[12px]\">{r.sku_code ?? \"—\"}</Cell>\n                  <Cell className=\"max-w-[300px] truncate\">{r.title ?? \"—\"}</Cell>\n                  <Cell className=\"text-[12px] text-muted-foreground\">{r.brand ?? \"—\"}</Cell>\n                  <Cell>\n                    <StatusBadge tone={toneForStatus(r.product_status ?? \"draft\")}>\n                      {r.product_status ?? \"unknown\"}\n                    </StatusBadge>\n                  </Cell>\n                  <Cell className=\"tabular-nums\">\n                    {r.price_minor == null ? \"—\" : formatEur(Number(r.price_minor))}\n                  </Cell>\n                  <Cell className=\"tabular-nums\">{r.available ?? 0}</Cell>\n                  <Cell className=\"tabular-nums\">{r.reserved ?? 0}</Cell>\n                  <Cell>\n                    {r.action_reason && r.action_reason !== \"none\" ? (\n                      <StatusBadge tone=\"warn\">{r.action_reason}</StatusBadge>\n                    ) : (\n                      <span className=\"text-[12px] text-muted-foreground\">—</span>\n                    )}\n                  </Cell>\n                </Row>\n              ))}\n            </DataTable>\n          )}\n\n          <div className=\"flex items-center justify-between gap-2\">\n            <Pagination page={page + 1} pageSize={PAGE_SIZE} total={rows.length} />\n            <div className=\"flex gap-1\">\n              <button\n                type=\"button\"\n                onClick={() => setPage((v) => Math.max(0, v - 1))}\n                disabled={page === 0}\n                className=\"rounded-sm border border-border bg-card px-2 py-1 text-[12px] disabled:opacity-40\"\n              >\n                Previous\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setPage((v) => ((v + 1) * PAGE_SIZE >= rows.length ? v : v + 1))}\n                disabled={(page + 1) * PAGE_SIZE >= rows.length}\n                className=\"rounded-sm border border-border bg-card px-2 py-1 text-[12px] disabled:opacity-40\"\n              >\n                Next\n              </button>\n            </div>\n          </div>\n        </>\n      )}\n\n      <Drawer\n        open={Boolean(selected)}\n        onClose={() => setSelected(null)}\n        title={selected?.title ?? \"Listing\"}\n      >\n        {selected ? (\n          <KeyValue\n            items={[\n              [\"SKU\", selected.sku_code ?? \"—\"],\n              [\"Brand\", selected.brand ?? \"—\"],\n              [\"Product status\", selected.product_status ?? \"—\"],\n              [\"SKU status\", selected.sku_status ?? \"—\"],\n              [\n                \"Price\",\n                selected.price_minor == null ? \"—\" : formatEur(Number(selected.price_minor)),\n              ],\n              [\"Currency\", selected.currency_code ?? \"—\"],\n              [\"Available\", String(selected.available ?? 0)],\n              [\"Reserved\", String(selected.reserved ?? 0)],\n              [\"Publication\", selected.publication_status ?? \"—\"],\n              [\"Tax classification\", selected.tax_classification ?? \"—\"],\n              [\"Fulfilment origin\", selected.fulfillment_origin ?? \"—\"],\n              [\"Delivery promise\", selected.delivery_promise ?? \"—\"],\n              [\"Action required\", selected.action_reason ?? \"none\"],\n            ]}\n          />\n        ) : null}\n      </Drawer>\n    </ManagerShell>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.dashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.finances.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.inventory.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"The 'all' logical expression could make the dependencies of useMemo Hook (at line 55) change on every render. To fix this, wrap the initialization of 'all' in its own useMemo() Hook.","line":43,"column":9,"nodeType":"VariableDeclarator","endLine":43,"endColumn":35}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { createFileRoute } from \"@tanstack/react-router\";\nimport { useMemo, useState } from \"react\";\nimport {\n  ManagerShell,\n  SELLER_NAV,\n  DataTable,\n  Row,\n  Cell,\n  StatusBadge,\n  DemoAction,\n  SearchInput,\n  Toolbar,\n  EmptyState,\n  Card,\n} from \"@/components/demo/shell\";\nimport { useActiveSellerWorkspace, useSellerInventory } from \"@/hooks/useSellerData\";\n\nexport const Route = createFileRoute(\"/_authenticated/seller/inventory\")({\n  ssr: false,\n  head: () => ({\n    meta: [\n      { title: \"Inventory — Borvat Seller Manager\" },\n      {\n        name: \"description\",\n        content:\n          \"Live read-only stock: on hand, reserved and available units per SKU and warehouse.\",\n      },\n      { name: \"robots\", content: \"noindex\" },\n      { property: \"og:title\", content: \"Inventory — Borvat Seller Manager\" },\n      { property: \"og:description\", content: \"Live stock levels per SKU and warehouse.\" },\n    ],\n  }),\n  component: SellerInventory,\n});\n\nfunction SellerInventory() {\n  const { active, isLoading: wsLoading, error: wsError } = useActiveSellerWorkspace();\n  const inventory = useSellerInventory(active?.company_id, active?.store_id, 500, 0);\n\n  const [q, setQ] = useState(\"\");\n  const [onlyLow, setOnlyLow] = useState(false);\n\n  const all = inventory.data ?? [];\n  const rows = useMemo(() => {\n    const needle = q.trim().toLowerCase();\n    return all\n      .filter((r) => (onlyLow ? (r.available ?? 0) <= 5 : true))\n      .filter((r) =>\n        needle === \"\"\n          ? true\n          : `${r.title ?? \"\"} ${r.sku_code ?? \"\"} ${r.warehouse_code ?? \"\"}`\n              .toLowerCase()\n              .includes(needle),\n      );\n  }, [all, q, onlyLow]);\n\n  const shopName = active?.store_name ?? active?.company_name ?? \"Seller Manager\";\n  const loading = wsLoading || inventory.isLoading;\n  const error = wsError ?? (inventory.error as Error | null);\n\n  return (\n    <ManagerShell\n      workspace=\"seller\"\n      navTitle=\"Seller Manager\"\n      shopName={shopName}\n      nav={SELLER_NAV}\n      classification=\"REAL READ-ONLY\"\n      title=\"Inventory\"\n      subtitle=\"Live balances from the append-only stock ledger · read-only\"\n      actions={<DemoAction label=\"Export CSV\" size=\"sm\" />}\n    >\n      {error ? (\n        <Card title=\"Data unavailable\">\n          <p className=\"text-[13px] text-muted-foreground\">{error.message}</p>\n        </Card>\n      ) : (\n        <>\n          <Toolbar>\n            <SearchInput\n              value={q}\n              onChange={setQ}\n              placeholder=\"Search product, SKU or warehouse…\"\n            />\n            <label className=\"flex items-center gap-2 rounded-sm border border-border bg-card px-3 py-1.5 text-[13px]\">\n              <input\n                type=\"checkbox\"\n                checked={onlyLow}\n                onChange={(e) => setOnlyLow(e.target.checked)}\n              />\n              Only low stock\n            </label>\n            <span className=\"text-[12px] text-muted-foreground\">\n              {loading ? \"Loading…\" : `${rows.length} of ${all.length} stock rows`}\n            </span>\n          </Toolbar>\n\n          {!loading && rows.length === 0 ? (\n            <EmptyState\n              title=\"No stock rows\"\n              hint=\"No inventory balances are recorded for this shop yet.\"\n            />\n          ) : (\n            <DataTable\n              columns={[\n                \"SKU\",\n                \"Product\",\n                \"Warehouse\",\n                \"Location\",\n                \"On hand\",\n                \"Reserved\",\n                \"Available\",\n                \"Published\",\n                \"Last movement\",\n              ]}\n              minWidth={1040}\n            >\n              {rows.map((r) => (\n                <Row key={`${r.sku_id}-${r.warehouse_code ?? \"\"}-${r.location_code ?? \"\"}`}>\n                  <Cell className=\"font-mono text-[12px]\">{r.sku_code ?? \"—\"}</Cell>\n                  <Cell className=\"max-w-[260px] truncate\">{r.title ?? \"—\"}</Cell>\n                  <Cell className=\"text-[12px]\">{r.warehouse_name ?? r.warehouse_code ?? \"—\"}</Cell>\n                  <Cell className=\"font-mono text-[12px]\">{r.location_code ?? \"—\"}</Cell>\n                  <Cell className=\"tabular-nums\">{r.on_hand ?? 0}</Cell>\n                  <Cell className=\"tabular-nums\">{r.reserved ?? 0}</Cell>\n                  <Cell className=\"tabular-nums\">\n                    {(r.available ?? 0) <= 5 ? (\n                      <StatusBadge tone=\"warn\">{r.available ?? 0}</StatusBadge>\n                    ) : (\n                      (r.available ?? 0)\n                    )}\n                  </Cell>\n                  <Cell className=\"tabular-nums\">{r.published_quantity ?? 0}</Cell>\n                  <Cell className=\"text-[12px] text-muted-foreground\">\n                    {r.last_movement_at\n                      ? new Date(r.last_movement_at).toLocaleString(\"en-GB\")\n                      : \"—\"}\n                  </Cell>\n                </Row>\n              ))}\n            </DataTable>\n          )}\n        </>\n      )}\n    </ManagerShell>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.listings.$listingId.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.manager.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.messages.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_authenticated/seller.onboarding.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/routes/_a