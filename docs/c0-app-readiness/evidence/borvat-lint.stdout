[{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/eslint.config.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/assign-product-images.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/buyer-account.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase1-tenancy-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase2-mig1-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase2-mig2-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase2-mig3-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase2-mig4-isolated.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase2-mig4-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase3-m1-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase3-m2-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase3-m3-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m1-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m2-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m3-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m4-adapter-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m4-bol-demo-smoke.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m4-checkpoint-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m4-post-m5-compat-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m4-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase4-m5-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/phase5-m0/generate-gate-report.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/redaction-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/security-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/scripts/seed-buyer-catalog.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/demo/inbox.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/demo/shell.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":632,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":632,"endColumn":28},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":655,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":655,"endColumn":30},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":1227,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":1227,"endColumn":31},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":1235,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":1235,"endColumn":35},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":1303,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":1303,"endColumn":34},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":1333,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":1333,"endColumn":36}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Link, useRouterState } from \"@tanstack/react-router\";\nimport { type ReactNode, useState } from \"react\";\nimport {\n  Bell,\n  ChevronDown,\n  ChevronRight,\n  CircleHelp,\n  Globe,\n  Info,\n  Menu,\n  Search,\n  Store,\n  X,\n} from \"lucide-react\";\nimport { toast } from \"sonner\";\nimport { cn } from \"@/lib/utils\";\nimport { useActiveSellerWorkspace } from \"@/hooks/useSellerData\";\n\nexport type Classification = \"DEMO DATA\" | \"REAL READ-ONLY\" | \"PLACEHOLDER\";\n\n/* ------------------------------------------------------------------ */\n/* Workspace identity                                                  */\n/* ------------------------------------------------------------------ */\n\nexport type Workspace = \"seller\" | \"admin\" | \"support\";\n\nconst workspaceTheme: Record<\n  Workspace,\n  {\n    bar: string;\n    sub: string;\n    accent: string;\n    chip: string;\n    label: string;\n    rule: string;\n    ruleAfter: string;\n  }\n> = {\n  seller: {\n    bar: \"bg-ink text-ink-foreground\",\n    sub: \"bg-ink-soft text-ink-foreground/85\",\n    accent: \"text-accent\",\n    chip: \"bg-accent/20 text-ink-foreground\",\n    label: \"Seller Manager\",\n    rule: \"bg-accent\",\n    ruleAfter: \"after:bg-accent\",\n  },\n  admin: {\n    bar: \"bg-ink text-ink-foreground\",\n    sub: \"bg-ink-soft text-ink-foreground/85\",\n    accent: \"text-amber-400\",\n    chip: \"bg-amber-400/20 text-amber-100\",\n    label: \"Borvat Admin\",\n    rule: \"bg-amber-400\",\n    ruleAfter: \"after:bg-amber-400\",\n  },\n  support: {\n    bar: \"bg-ink text-ink-foreground\",\n    sub: \"bg-ink-soft text-ink-foreground/85\",\n    accent: \"text-teal-300\",\n    chip: \"bg-teal-400/20 text-teal-100\",\n    label: \"Customer Service\",\n    rule: \"bg-teal-300\",\n    ruleAfter: \"after:bg-teal-300\",\n  },\n};\n\nexport type NavItem = { to: string; label: string; children?: NavItem[]; badge?: number };\n\n/* ------------------------------------------------------------------ */\n/* Chrome pieces                                                       */\n/* ------------------------------------------------------------------ */\n\nfunction DemoModeChip() {\n  const [open, setOpen] = useState(false);\n  return (\n    <div className=\"relative\">\n      <button\n        type=\"button\"\n        onClick={() => setOpen((v) => !v)}\n        className=\"rounded-sm border border-white/25 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/80 hover:bg-white/10\"\n      >\n        Demo mode\n      </button>\n      {open ? (\n        <div className=\"absolute right-0 top-full z-50 mt-1 w-64 rounded-sm border border-border bg-popover p-3 text-xs text-popover-foreground shadow-xl\">\n          Frontend fixtures — no production writes. Nothing on these screens reads from or writes to\n          the database.\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nexport function ClassificationChip({\n  classification = \"DEMO DATA\",\n}: {\n  classification?: Classification;\n}) {\n  const style =\n    classification === \"DEMO DATA\"\n      ? \"border-border bg-muted text-muted-foreground\"\n      : classification === \"REAL READ-ONLY\"\n        ? \"border-sky-200 bg-sky-50 text-sky-800\"\n        : \"border-border bg-muted text-muted-foreground\";\n  return (\n    <span\n      className={cn(\n        \"inline-flex items-center rounded-sm border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide\",\n        style,\n      )}\n    >\n      {classification}\n    </span>\n  );\n}\n\n/** Kept for compatibility; renders a single compact inline note. */\nexport function DemoBanner({ note }: { note?: string; classification?: Classification }) {\n  if (!note) return null;\n  return <p className=\"text-xs text-muted-foreground\">{note}</p>;\n}\n\nfunction TopNavLink({\n  item,\n  pathname,\n  theme,\n}: {\n  item: NavItem;\n  pathname: string;\n  theme: (typeof workspaceTheme)[Workspace];\n}) {\n  const [open, setOpen] = useState(false);\n  const active =\n    pathname === item.to ||\n    pathname.startsWith(item.to + \"/\") ||\n    (item.children ?? []).some((c) => pathname === c.to || pathname.startsWith(c.to + \"/\"));\n\n  const base = cn(\n    \"relative flex items-center gap-1.5 whitespace-nowrap px-3 py-2.5 text-[13px] font-medium leading-5 text-white/75 transition-colors hover:text-white\",\n    active && \"font-semibold text-white\",\n    active &&\n      cn(\n        \"after:absolute after:inset-x-2 after:bottom-0 after:h-[3px] after:rounded-t-full\",\n        theme.ruleAfter,\n      ),\n  );\n\n  if (!item.children?.length) {\n    return (\n      <Link to={item.to} className={base}>\n        {item.label}\n        {item.badge ? (\n          <span className={cn(\"rounded-sm px-1 text-[10px] font-bold\", theme.chip)}>\n            {item.badge}\n          </span>\n        ) : null}\n      </Link>\n    );\n  }\n\n  return (\n    <div\n      className=\"relative\"\n      onMouseEnter={() => setOpen(true)}\n      onMouseLeave={() => setOpen(false)}\n    >\n      <button type=\"button\" onClick={() => setOpen((v) => !v)} className={base}>\n        {item.label}\n        <ChevronDown className=\"h-3 w-3\" />\n      </button>\n      {open ? (\n        <div className=\"absolute left-0 top-full z-50 min-w-56 rounded-sm border border-border bg-popover py-1 shadow-xl\">\n          {item.children.map((c) => (\n            <Link\n              key={c.to}\n              to={c.to}\n              onClick={() => setOpen(false)}\n              className=\"block px-3 py-1.5 text-[13px] text-popover-foreground hover:bg-muted\"\n            >\n              {c.label}\n            </Link>\n          ))}\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nfunction ShopSwitcher({ shopName }: { shopName: string }) {\n  const [open, setOpen] = useState(false);\n  const { workspaces, active, select } = useActiveSellerWorkspace();\n  const label = active?.store_name ?? active?.company_name ?? shopName;\n  return (\n    <div className=\"relative\">\n      <button\n        type=\"button\"\n        onClick={() => setOpen((v) => !v)}\n        className=\"flex max-w-[220px] items-center gap-1.5 rounded-sm bg-white/10 px-2 py-1 text-[13px] text-white hover:bg-white/15\"\n      >\n        <Store className=\"h-3.5 w-3.5 shrink-0\" />\n        <span className=\"truncate\">{label}</span>\n        <ChevronDown className=\"h-3 w-3 shrink-0\" />\n      </button>\n      {open ? (\n        <div className=\"absolute left-0 top-full z-50 mt-1 w-64 rounded-sm border border-border bg-popover py-1 text-popover-foreground shadow-xl\">\n          <div className=\"px-3 py-2 text-[11px] uppercase tracking-wide text-muted-foreground\">\n            Current shop\n          </div>\n          <div className=\"px-3 pb-2 text-sm font-semibold\">{label}</div>\n          <div className=\"border-t border-border\" />\n          {workspaces.length > 0 ? (\n            <div className=\"max-h-56 overflow-auto py-1\">\n              {workspaces.map((w) => {\n                const isActive =\n                  active?.company_id === w.company_id && active?.store_id === w.store_id;\n                return (\n                  <button\n                    key={`${w.company_id}:${w.store_id ?? \"none\"}`}\n                    type=\"button\"\n                    onClick={() => {\n                      select(w);\n                      setOpen(false);\n                    }}\n                    className={cn(\n                      \"block w-full truncate px-3 py-1.5 text-left text-[13px] hover:bg-muted\",\n                      isActive && \"font-semibold\",\n                    )}\n                  >\n                    {w.store_name ?? w.company_name}\n                    <span className=\"block text-[11px] text-muted-foreground\">\n                      {w.company_name}\n                    </span>\n                  </button>\n                );\n              })}\n            </div>\n          ) : (\n            <div className=\"px-3 py-2 text-[12px] text-muted-foreground\">\n              No authorised shop found for this account.\n            </div>\n          )}\n          <div className=\"border-t border-border\" />\n          <Link to=\"/seller/store\" className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\">\n            Store settings\n          </Link>\n          <Link to=\"/seller/settings\" className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\">\n            Apps &amp; integrations\n          </Link>\n          <Link to=\"/account\" className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\">\n            Log out\n          </Link>\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nexport function ManagerShell({\n  title,\n  subtitle,\n  nav,\n  navTitle,\n  children,\n  actions,\n  workspace,\n  shopName,\n  classification = \"DEMO DATA\",\n  tabs,\n}: {\n  title: string;\n  subtitle?: string;\n  nav: NavItem[];\n  navTitle: string;\n  children: ReactNode;\n  actions?: ReactNode;\n  workspace?: Workspace;\n  shopName?: string;\n  classification?: Classification;\n  tabs?: ReactNode;\n}) {\n  const pathname = useRouterState({ select: (s) => s.location.pathname });\n  const ws: Workspace =\n    workspace ??\n    (pathname.startsWith(\"/admin\")\n      ? \"admin\"\n      : pathname.startsWith(\"/support\")\n        ? \"support\"\n        : \"seller\");\n  const theme = workspaceTheme[ws];\n  const [userMenu, setUserMenu] = useState(false);\n  const [mobileNav, setMobileNav] = useState(false);\n  const flat = nav.flatMap((n) => [n, ...(n.children ?? [])]);\n  const current =\n    flat.find((n) => n.to === pathname) ?? flat.find((n) => pathname.startsWith(n.to + \"/\"));\n\n  return (\n    <div className=\"flex min-h-screen flex-col bg-[#f4f5f7]\">\n      <header className=\"sticky top-0 z-40\">\n        <div className={theme.bar}>\n          <div className=\"mx-auto flex w-full max-w-[1600px] items-center gap-3 px-3 py-2 xl:px-6\">\n            <button\n              type=\"button\"\n              onClick={() => setMobileNav(true)}\n              className=\"rounded-sm p-1 hover:bg-white/10 lg:hidden\"\n              aria-label=\"Open navigation\"\n            >\n              <Menu className=\"h-5 w-5\" />\n            </button>\n            <Link to=\"/\" className=\"shrink-0 text-base font-black tracking-tight\">\n              borvat<span className={theme.accent}>.</span>\n            </Link>\n            <span\n              className={cn(\n                \"hidden rounded-sm px-1.5 py-0.5 text-[11px] font-semibold sm:inline\",\n                theme.chip,\n              )}\n            >\n              {theme.label}\n            </span>\n            {ws === \"seller\" && shopName ? (\n              <div className=\"hidden md:block\">\n                <ShopSwitcher shopName={shopName} />\n              </div>\n            ) : null}\n\n            <div className=\"ml-auto flex items-center gap-2\">\n              <div className=\"relative hidden lg:block\">\n                <Search className=\"pointer-events-none absolute left-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-white/60\" />\n                <input\n                  placeholder=\"Search orders, SKU, EAN…\"\n                  className=\"w-56 rounded-sm border border-white/20 bg-white/10 py-1 pl-7 pr-2 text-[13px] text-white placeholder:text-white/55 focus:outline-none focus:ring-1 focus:ring-white/40\"\n                />\n              </div>\n              <DemoModeChip />\n              <button\n                type=\"button\"\n                onClick={() => toast.info(\"Demo notifications\", { description: \"3 unread items\" })}\n                className=\"relative rounded-sm p-1 hover:bg-white/10\"\n                aria-label=\"Notifications\"\n              >\n                <Bell className=\"h-4 w-4\" />\n                <span className=\"absolute right-0 top-0 h-1.5 w-1.5 rounded-full bg-red-400\" />\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => toast.info(\"Help centre\", { description: \"Demo placeholder\" })}\n                className=\"hidden rounded-sm p-1 hover:bg-white/10 sm:block\"\n                aria-label=\"Help\"\n              >\n                <CircleHelp className=\"h-4 w-4\" />\n              </button>\n              <span className=\"hidden items-center gap-1 text-[12px] text-white/80 sm:flex\">\n                <Globe className=\"h-3.5 w-3.5\" /> NL\n              </span>\n              <div className=\"relative\">\n                <button\n                  type=\"button\"\n                  onClick={() => setUserMenu((v) => !v)}\n                  className=\"flex items-center gap-1 rounded-sm px-1.5 py-1 text-[13px] text-white/85 hover:bg-white/10\"\n                >\n                  {navTitle}\n                  <ChevronDown className=\"h-3 w-3\" />\n                </button>\n                {userMenu ? (\n                  <div className=\"absolute right-0 top-full z-50 mt-1 w-52 rounded-sm border border-border bg-popover py-1 text-popover-foreground shadow-xl\">\n                    <Link\n                      to=\"/owner-review\"\n                      className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\"\n                    >\n                      Owner review hub\n                    </Link>\n                    <Link\n                      to=\"/seller/manager\"\n                      className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\"\n                    >\n                      Seller Manager\n                    </Link>\n                    <Link\n                      to=\"/admin/dashboard\"\n                      className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\"\n                    >\n                      Borvat Admin\n                    </Link>\n                    <Link\n                      to=\"/support/inbox/customers\"\n                      className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\"\n                    >\n                      Customer Service\n                    </Link>\n                    <div className=\"border-t border-border\" />\n                    <Link to=\"/account\" className=\"block px-3 py-1.5 text-[13px] hover:bg-muted\">\n                      Account\n                    </Link>\n                  </div>\n                ) : null}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className={cn(theme.sub, \"hidden lg:block\")}>\n          <div className=\"mx-auto flex w-full max-w-[1600px] items-center px-3 xl:px-6\">\n            <nav className=\"flex flex-1 items-center overflow-x-auto\">\n              {nav.map((n) => (\n                <TopNavLink key={n.to} item={n} pathname={pathname} theme={theme} />\n              ))}\n            </nav>\n          </div>\n        </div>\n      </header>\n\n      {mobileNav ? (\n        <div className=\"fixed inset-0 z-50 flex lg:hidden\" onClick={() => setMobileNav(false)}>\n          <div className=\"absolute inset-0 bg-black/50\" />\n          <div\n            className=\"relative flex h-full w-72 flex-col overflow-y-auto bg-background\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <div className={cn(\"flex items-center justify-between px-3 py-2\", theme.bar)}>\n              <span className=\"text-sm font-bold\">{theme.label}</span>\n              <button type=\"button\" onClick={() => setMobileNav(false)} aria-label=\"Close\">\n                <X className=\"h-4 w-4\" />\n              </button>\n            </div>\n            <nav className=\"p-2\">\n              {nav.map((n) => (\n                <div key={n.to} className=\"mb-1\">\n                  <Link\n                    to={n.to}\n                    onClick={() => setMobileNav(false)}\n                    className={cn(\n                      \"block rounded-sm px-2 py-1.5 text-sm\",\n                      pathname === n.to ? \"bg-muted font-semibold\" : \"hover:bg-muted\",\n                    )}\n                  >\n                    {n.label}\n                  </Link>\n                  {n.children?.map((c) => (\n                    <Link\n                      key={c.to}\n                      to={c.to}\n                      onClick={() => setMobileNav(false)}\n                      className=\"block rounded-sm px-4 py-1.5 text-[13px] text-muted-foreground hover:bg-muted\"\n                    >\n                      {c.label}\n                    </Link>\n                  ))}\n                </div>\n              ))}\n            </nav>\n          </div>\n        </div>\n      ) : null}\n\n      <div className=\"border-b border-border bg-background\">\n        <div className=\"mx-auto w-full max-w-[1600px] px-3 pt-3 xl:px-6\">\n          <nav className=\"flex items-center gap-1 text-[12px] text-muted-foreground\">\n            <Link to={nav[0].to} className=\"hover:underline\">\n              {navTitle}\n            </Link>\n            <ChevronRight className=\"h-3 w-3\" />\n            <span className=\"font-medium text-foreground\">{current?.label ?? title}</span>\n          </nav>\n          <div className=\"mt-1 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3 pb-2\">\n            <div className=\"min-w-0\">\n              <h1 className=\"truncate text-xl font-bold tracking-tight\">{title}</h1>\n              {subtitle ? (\n                <p className=\"truncate text-[12px] text-muted-foreground\">{subtitle}</p>\n              ) : null}\n            </div>\n            <div className=\"flex shrink-0 flex-wrap items-center justify-end gap-1.5\">\n              <ClassificationChip classification={classification} />\n              {actions}\n            </div>\n          </div>\n          {tabs}\n        </div>\n      </div>\n\n      <main className=\"mx-auto w-full max-w-[1600px] flex-1 px-3 py-3 xl:px-6\">{children}</main>\n    </div>\n  );\n}\n\n/* ------------------------------------------------------------------ */\n/* Building blocks                                                     */\n/* ------------------------------------------------------------------ */\n\nexport function Card({\n  title,\n  description,\n  children,\n  className,\n  action,\n}: {\n  title?: string;\n  description?: string;\n  children: ReactNode;\n  className?: string;\n  action?: ReactNode;\n}) {\n  return (\n    <section className={cn(\"rounded-md border border-border bg-card shadow-xs\", className)}>\n      {title ? (\n        <header className=\"flex items-center justify-between gap-2 border-b border-border px-3 py-2\">\n          <div className=\"min-w-0\">\n            <h2 className=\"truncate text-[13px] font-semibold\">{title}</h2>\n            {description ? (\n              <p className=\"truncate text-[11px] text-muted-foreground\">{description}</p>\n            ) : null}\n          </div>\n          {action}\n        </header>\n      ) : null}\n      <div className=\"p-3\">{children}</div>\n    </section>\n  );\n}\n\nexport function Metric({\n  label,\n  value,\n  hint,\n  tone = \"neutral\",\n  to,\n}: {\n  label: string;\n  value: string;\n  hint?: string;\n  tone?: BadgeTone;\n  to?: string;\n}) {\n  const border =\n    tone === \"bad\"\n      ? \"border-l-red-500\"\n      : tone === \"warn\"\n        ? \"border-l-amber-500\"\n        : tone === \"good\"\n          ? \"border-l-emerald-500\"\n          : \"border-l-brand\";\n  const body = (\n    <div\n      className={cn(\n        \"h-full rounded-md border border-l-4 border-border bg-card px-3 py-3 shadow-xs transition-colors\",\n        border,\n        to && \"hover:bg-muted/60\",\n      )}\n    >\n      <div className=\"truncate text-[11px] uppercase tracking-wide text-muted-foreground\">\n        {label}\n      </div>\n      <div className=\"mt-0.5 text-2xl font-bold leading-tight tabular-nums\">{value}</div>\n      {hint ? <div className=\"text-[11px] text-muted-foreground\">{hint}</div> : null}\n    </div>\n  );\n  return to ? (\n    <Link to={to} className=\"block\">\n      {body}\n    </Link>\n  ) : (\n    body\n  );\n}\n\nconst toneMap: Record<string, string> = {\n  neutral: \"bg-muted text-muted-foreground border-border\",\n  good: \"bg-emerald-50 text-emerald-800 border-emerald-200\",\n  warn: \"bg-amber-50 text-amber-900 border-amber-200\",\n  bad: \"bg-red-50 text-red-800 border-red-200\",\n  info: \"bg-sky-50 text-sky-800 border-sky-200\",\n};\n\nexport type BadgeTone = keyof typeof toneMap;\n\n/**\n * BORVAT MANAGER VISUAL BASELINE V1 — single English label vocabulary.\n * Internal snake_case values stay as-is in data and code; only the rendered\n * label is humanised so no screen mixes raw keys with prose.\n */\nconst STATUS_LABELS: Record<string, string> = {\n  new: \"New\",\n  open: \"Open\",\n  processing: \"Processing\",\n  shipped: \"Shipped\",\n  delivered: \"Delivered\",\n  cancelled: \"Cancelled\",\n  return: \"Return\",\n  resolved: \"Resolved\",\n  waiting_customer: \"Waiting on customer\",\n  waiting_merchant: \"Waiting on seller\",\n  waiting_borvat: \"Waiting on Borvat\",\n  not_created: \"Not created\",\n  created: \"Created\",\n  handed_over: \"Handed over\",\n  published: \"Published\",\n  active: \"Active\",\n  paused: \"Paused\",\n  draft: \"Draft\",\n  review: \"In review\",\n  under_review: \"Under review\",\n  pending: \"Pending\",\n  submitted: \"Submitted\",\n  offered: \"Offered\",\n  awaiting_offer: \"Awaiting offer\",\n  accepted: \"Accepted\",\n  expired: \"Expired\",\n  superseded: \"Superseded\",\n  verified: \"Verified\",\n  connected: \"Connected\",\n  sandbox: \"Sandbox\",\n  blocked: \"Blocked\",\n  breached: \"Breached\",\n  at_risk: \"At risk\",\n  ok: \"On target\",\n  low: \"Low\",\n  normal: \"Normal\",\n  high: \"High\",\n  good_standing: \"Good standing\",\n  winning: \"Winning\",\n  paid: \"Paid\",\n  unpaid: \"Unpaid\",\n  shipping_issue: \"Shipping issue\",\n  product_question: \"Product question\",\n  quote_followup: \"Quote follow-up\",\n  dispute: \"Dispute\",\n  out_of_stock: \"Out of stock\",\n  in_stock: \"In stock\",\n  low_stock: \"Low stock\",\n};\n\nexport function statusLabel(value: string): string {\n  return STATUS_LABELS[value] ?? value.replace(/_/g, \" \").replace(/^./, (c) => c.toUpperCase());\n}\n\nexport function StatusBadge({\n  children,\n  tone = \"neutral\",\n}: {\n  children: ReactNode;\n  tone?: BadgeTone;\n}) {\n  return (\n    <span\n      className={cn(\n        \"inline-flex items-center whitespace-nowrap rounded-sm border px-1.5 py-0.5 text-[11px] font-medium\",\n        toneMap[tone],\n      )}\n    >\n      {typeof children === \"string\" ? statusLabel(children) : children}\n    </span>\n  );\n}\n\nexport function toneForStatus(status: string): BadgeTone {\n  if (\n    [\n      \"published\",\n      \"active\",\n      \"verified\",\n      \"accepted\",\n      \"connected\",\n      \"good_standing\",\n      \"resolved\",\n      \"winning\",\n      \"delivered\",\n      \"paid\",\n      \"ok\",\n    ].includes(status)\n  )\n    return \"good\";\n  if (\n    [\n      \"review\",\n      \"pending\",\n      \"offered\",\n      \"awaiting_offer\",\n      \"submitted\",\n      \"waiting_merchant\",\n      \"waiting_customer\",\n      \"sandbox\",\n      \"paused\",\n      \"under_review\",\n      \"losing\",\n      \"processing\",\n      \"shipped\",\n      \"at_risk\",\n    ].includes(status)\n  )\n    return \"warn\";\n  if (\n    [\n      \"expired\",\n      \"action_required\",\n      \"unpublished\",\n      \"not_connected\",\n      \"superseded\",\n      \"cancelled\",\n      \"breached\",\n      \"failed\",\n    ].includes(status)\n  )\n    return \"bad\";\n  if ([\"open\", \"draft\", \"new\", \"requested\"].includes(status)) return \"info\";\n  return \"neutral\";\n}\n\nexport function Toolbar({ children }: { children: ReactNode }) {\n  return (\n    <div className=\"mb-2 flex flex-wrap items-center gap-2 rounded-md border border-border bg-card px-2.5 py-2 shadow-xs\">\n      {children}\n    </div>\n  );\n}\n\nexport function DataTable({\n  columns,\n  children,\n  minWidth = 900,\n}: {\n  columns: (string | ReactNode)[];\n  children: ReactNode;\n  minWidth?: number;\n}) {\n  return (\n    <div className=\"overflow-x-auto rounded-md border border-border bg-card shadow-xs\">\n      <table\n        className=\"w-full text-[13px] [&_tbody_tr]:border-b [&_tbody_tr]:border-border [&_tbody_tr:last-child]:border-0 [&_tbody_tr:hover]:bg-muted/40\"\n        style={{ minWidth }}\n      >\n        <thead>\n          <tr className=\"border-b border-border bg-muted/70 text-left\">\n            {columns.map((c, i) => (\n              <th\n                key={i}\n                className=\"whitespace-nowrap px-3 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-muted-foreground\"\n              >\n                {c}\n              </th>\n            ))}\n          </tr>\n        </thead>\n        <tbody>{children}</tbody>\n      </table>\n    </div>\n  );\n}\n\nexport function Row({\n  children,\n  onClick,\n  selected,\n}: {\n  children: ReactNode;\n  onClick?: () => void;\n  selected?: boolean;\n}) {\n  return (\n    <tr\n      onClick={onClick}\n      className={cn(\n        \"border-b border-border last:border-0 hover:bg-muted/50\",\n        onClick && \"cursor-pointer\",\n        selected && \"bg-sky-50/70\",\n      )}\n    >\n      {children}\n    </tr>\n  );\n}\n\nexport function Cell({ children, className }: { children: ReactNode; className?: string }) {\n  return <td className={cn(\"px-3 py-2.5 align-middle\", className)}>{children}</td>;\n}\n\nexport function Pagination({\n  total,\n  page = 1,\n  pageSize = 25,\n}: {\n  total: number;\n  page?: number;\n  pageSize?: number;\n}) {\n  const from = total === 0 ? 0 : (page - 1) * pageSize + 1;\n  const to = Math.min(total, page * pageSize);\n  return (\n    <div className=\"mt-2 flex flex-wrap items-center justify-between gap-2 text-[12px] text-muted-foreground\">\n      <span>\n        {from}–{to} of {total}\n      </span>\n      <div className=\"flex items-center gap-1\">\n        <DemoAction label=\"Previous\" size=\"sm\" />\n        <span className=\"rounded-sm border border-border bg-card px-2 py-1 text-foreground\">\n          {page}\n        </span>\n        <DemoAction label=\"Next\" size=\"sm\" />\n      </div>\n    </div>\n  );\n}\n\nexport function EmptyState({\n  title,\n  hint,\n  action,\n}: {\n  title: string;\n  hint?: string;\n  action?: ReactNode;\n}) {\n  return (\n    <div className=\"rounded-md border border-dashed border-border bg-card px-4 py-14 text-center\">\n      <Info className=\"mx-auto mb-2 h-5 w-5 text-muted-foreground\" />\n      <div className=\"text-sm font-medium\">{title}</div>\n      {hint ? <div className=\"mt-1 text-[12px] text-muted-foreground\">{hint}</div> : null}\n      {action ? <div className=\"mt-3\">{action}</div> : null}\n    </div>\n  );\n}\n\nexport function LoadingRows({ rows = 3, cols = 4 }: { rows?: number; cols?: number }) {\n  return (\n    <>\n      {Array.from({ length: rows }).map((_, r) => (\n        <tr key={r} className=\"border-b border-border last:border-0\">\n          {Array.from({ length: cols }).map((__, c) => (\n            <td key={c} className=\"px-2 py-2\">\n              <div className=\"h-3 w-full animate-pulse rounded bg-muted\" />\n            </td>\n          ))}\n        </tr>\n      ))}\n    </>\n  );\n}\n\nexport function Skeleton({ className }: { className?: string }) {\n  return <div className={cn(\"animate-pulse rounded bg-muted\", className)} />;\n}\n\n/* Unified action hierarchy used across every manager surface. */\nexport type ActionVariant = \"primary\" | \"secondary\" | \"ghost\" | \"destructive\" | \"icon\";\nexport type ActionSize = \"sm\" | \"md\" | \"lg\";\n\nconst actionSize: Record<ActionSize, string> = {\n  sm: \"h-7 px-2 text-[12px]\",\n  md: \"h-8 px-3 text-[13px]\",\n  lg: \"h-9 px-4 text-[13px]\",\n};\n\nconst actionVariant: Record<ActionVariant, string> = {\n  primary:\n    \"bg-ink text-ink-foreground shadow-sm hover:bg-ink-soft focus-visible:ring-2 focus-visible:ring-accent\",\n  secondary:\n    \"border border-border bg-card text-foreground shadow-xs hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring\",\n  ghost: \"text-foreground hover:bg-muted\",\n  destructive: \"bg-destructive text-destructive-foreground shadow-sm hover:opacity-90\",\n  icon: \"h-8 w-8 justify-center border border-border bg-card p-0 text-muted-foreground hover:bg-muted hover:text-foreground\",\n};\n\n/** Any control that is intentionally not wired to the backend. */\nexport function DemoAction({\n  label,\n  variant = \"secondary\",\n  size = \"md\",\n  className,\n  icon,\n  disabled,\n  title,\n}: {\n  label: string;\n  variant?: ActionVariant;\n  size?: ActionSize;\n  className?: string;\n  icon?: ReactNode;\n  disabled?: boolean;\n  title?: string;\n}) {\n  return (\n    <button\n      type=\"button\"\n      disabled={disabled}\n      aria-label={variant === \"icon\" ? label : undefined}\n      title={title ?? (disabled ? \"Unavailable in this demo\" : \"Demo action — not persisted\")}\n      onClick={(e) => {\n        e.stopPropagation();\n        toast.info(\"Demo action — not persisted\", { description: label });\n      }}\n      className={cn(\n        \"inline-flex shrink-0 items-center gap-1.5 rounded-md font-medium leading-none transition-colors outline-none disabled:pointer-events-none disabled:opacity-45\",\n        variant === \"icon\" ? actionVariant.icon : cn(actionSize[size], actionVariant[variant]),\n        className,\n      )}\n    >\n      {icon}\n      {variant === \"icon\" ? null : label}\n    </button>\n  );\n}\n\nexport function SearchInput({\n  value,\n  onChange,\n  placeholder,\n  className,\n}: {\n  value: string;\n  onChange: (v: string) => void;\n  placeholder?: string;\n  className?: string;\n}) {\n  return (\n    <div className={cn(\"relative min-w-[200px] flex-1\", className)}>\n      <Search className=\"pointer-events-none absolute left-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-muted-foreground\" />\n      <input\n        type=\"search\"\n        value={value}\n        onChange={(e) => onChange(e.target.value)}\n        placeholder={placeholder ?? \"Search…\"}\n        className=\"h-8 w-full rounded-md border border-border bg-background pl-7 pr-2 text-[13px] outline-none focus:ring-2 focus:ring-ring/40\"\n      />\n    </div>\n  );\n}\n\nexport function FilterSelect({\n  label,\n  value,\n  onChange,\n  options,\n}: {\n  label: string;\n  value: string;\n  onChange: (v: string) => void;\n  options: { value: string; label: string }[];\n}) {\n  return (\n    <label className=\"flex items-center gap-1 text-[12px] text-muted-foreground\">\n      {label}\n      <select\n        value={value}\n        onChange={(e) => onChange(e.target.value)}\n        className=\"h-8 rounded-md border border-border bg-background px-2 text-[13px] text-foreground outline-none focus:ring-2 focus:ring-ring/40\"\n      >\n        {options.map((o) => (\n          <option key={o.value} value={o.value}>\n            {o.label}\n          </option>\n        ))}\n      </select>\n    </label>\n  );\n}\n\nexport function Tabs({\n  tabs,\n  active,\n  onChange,\n}: {\n  tabs: { id: string; label: string; count?: number }[];\n  active: string;\n  onChange: (id: string) => void;\n}) {\n  return (\n    <div className=\"flex flex-wrap items-center gap-0.5 overflow-x-auto border-b border-border\">\n      {tabs.map((t) => (\n        <button\n          key={t.id}\n          type=\"button\"\n          onClick={() => onChange(t.id)}\n          className={cn(\n            \"-mb-px flex items-center gap-1 whitespace-nowrap border-b-2 px-2.5 py-1.5 text-[13px]\",\n            active === t.id\n              ? \"border-brand font-semibold text-foreground\"\n              : \"border-transparent text-muted-foreground hover:text-foreground\",\n          )}\n        >\n          {t.label}\n          {typeof t.count === \"number\" ? (\n            <span className=\"rounded-sm bg-muted px-1 text-[11px] tabular-nums\">{t.count}</span>\n          ) : null}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nexport function Drawer({\n  open,\n  onClose,\n  title,\n  subtitle,\n  children,\n  footer,\n}: {\n  open: boolean;\n  onClose: () => void;\n  title: string;\n  subtitle?: string;\n  children: ReactNode;\n  footer?: ReactNode;\n}) {\n  if (!open) return null;\n  return (\n    <div className=\"fixed inset-0 z-50 flex justify-end bg-black/40\" onClick={onClose}>\n      <div\n        className=\"flex h-full w-full max-w-xl flex-col bg-background shadow-2xl\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <header className=\"flex items-start justify-between gap-2 border-b border-border px-3 py-2\">\n          <div className=\"min-w-0\">\n            <h2 className=\"truncate text-sm font-semibold\">{title}</h2>\n            {subtitle ? (\n              <p className=\"truncate text-[12px] text-muted-foreground\">{subtitle}</p>\n            ) : null}\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-sm border border-border px-1.5 py-1 text-[12px] hover:bg-muted\"\n          >\n            Close\n          </button>\n        </header>\n        <div className=\"flex-1 space-y-3 overflow-y-auto p-3\">{children}</div>\n        {footer ? (\n          <footer className=\"flex flex-wrap gap-1.5 border-t border-border bg-muted/40 px-3 py-2\">\n            {footer}\n          </footer>\n        ) : null}\n      </div>\n    </div>\n  );\n}\n\nexport function KeyValue({ items }: { items: [string, ReactNode][] }) {\n  return (\n    <dl className=\"grid grid-cols-[minmax(0,140px)_minmax(0,1fr)] gap-x-3 gap-y-1 text-[13px]\">\n      {items.map(([k, v], i) => (\n        <div key={i} className=\"contents\">\n          <dt className=\"text-muted-foreground\">{k}</dt>\n          <dd className=\"min-w-0 break-words font-medium\">{v}</dd>\n        </div>\n      ))}\n    </dl>\n  );\n}\n\n/**\n * Reporting chart: y-axis ticks, gridlines, optional comparison series,\n * legend, hover tooltip, range selector and an export action.\n */\nexport function BarChart({\n  data,\n  format,\n  seriesLabel = \"This period\",\n  compareLabel = \"Previous period\",\n  ranges = [\"7d\", \"30d\", \"12m\"],\n  onRangeChange,\n  height = 200,\n}: {\n  data: { label: string; value: number; compare?: number }[];\n  format?: (v: number) => string;\n  seriesLabel?: string;\n  compareLabel?: string;\n  ranges?: string[];\n  onRangeChange?: (range: string) => void;\n  height?: number;\n}) {\n  const fmt = format ?? ((v: number) => String(v));\n  const [range, setRange] = useState(ranges[1] ?? ranges[0]);\n  const [hover, setHover] = useState<number | null>(null);\n  const hasCompare = data.some((d) => typeof d.compare === \"number\");\n  const max = Math.max(1, ...data.map((d) => Math.max(d.value, d.compare ?? 0)));\n  const ticks = [1, 0.75, 0.5, 0.25, 0];\n  const total = data.reduce((s, d) => s + d.value, 0);\n  const compareTotal = data.reduce((s, d) => s + (d.compare ?? 0), 0);\n  const delta = compareTotal ? ((total - compareTotal) / compareTotal) * 100 : null;\n\n  return (\n    <div>\n      <div className=\"mb-3 flex flex-wrap items-center justify-between gap-2\">\n        <div className=\"flex flex-wrap items-center gap-3 text-[12px]\">\n          <span className=\"inline-flex items-center gap-1.5\">\n            <span className=\"h-2.5 w-2.5 rounded-[2px] bg-ink\" />\n            {seriesLabel}\n          </span>\n          {hasCompare ? (\n            <span className=\"inline-flex items-center gap-1.5 text-muted-foreground\">\n              <span className=\"h-2.5 w-2.5 rounded-[2px] bg-muted-foreground/35\" />\n              {compareLabel}\n            </span>\n          ) : null}\n          {delta !== null ? (\n            <span\n              className={cn(\n                \"rounded-md px-1.5 py-0.5 text-[11px] font-semibold\",\n                delta >= 0 ? \"bg-emerald-50 text-emerald-700\" : \"bg-red-50 text-red-700\",\n              )}\n            >\n              {delta >= 0 ? \"▲\" : \"▼\"} {Math.abs(delta).toFixed(1)}%\n            </span>\n          ) : null}\n        </div>\n        <div className=\"flex items-center gap-1.5\">\n          <div className=\"flex overflow-hidden rounded-md border border-border\">\n            {ranges.map((r) => (\n              <button\n                key={r}\n                type=\"button\"\n                onClick={() => {\n                  setRange(r);\n                  onRangeChange?.(r);\n                }}\n                className={cn(\n                  \"px-2 py-1 text-[12px] transition-colors\",\n                  range === r\n                    ? \"bg-ink text-ink-foreground\"\n                    : \"bg-card text-muted-foreground hover:bg-muted\",\n                )}\n              >\n                {r}\n              </button>\n            ))}\n          </div>\n          <DemoAction label=\"Export CSV\" size=\"sm\" />\n        </div>\n      </div>\n\n      <div className=\"flex gap-2\">\n        <div\n          className=\"flex w-14 shrink-0 flex-col justify-between text-right text-[10px] tabular-nums text-muted-foreground\"\n          style={{ height }}\n        >\n          {ticks.map((t) => (\n            <span key={t}>{fmt(Math.round(max * t))}</span>\n          ))}\n        </div>\n        <div className=\"relative min-w-0 flex-1\">\n          <div className=\"absolute inset-0 flex flex-col justify-between\" style={{ height }}>\n            {ticks.map((t) => (\n              <div key={t} className=\"border-t border-dashed border-border/70\" />\n            ))}\n          </div>\n          <div className=\"relative flex items-end gap-1.5\" style={{ height }}>\n            {data.map((d, i) => (\n              <div\n                key={d.label}\n                onMouseEnter={() => setHover(i)}\n                onMouseLeave={() => setHover(null)}\n                className=\"group relative flex h-full flex-1 items-end justify-center gap-0.5\"\n              >\n                {hasCompare ? (\n                  <div\n                    className=\"w-1/3 rounded-t-[3px] bg-muted-foreground/25\"\n                    style={{ height: `${Math.max(2, ((d.compare ?? 0) / max) * 100)}%` }}\n                  />\n                ) : null}\n                <div\n                  className={cn(\n                    \"rounded-t-[3px] bg-ink transition-colors\",\n                    hasCompare ? \"w-1/3\" : \"w-2/3\",\n                    hover === i && \"bg-accent\",\n                  )}\n                  style={{ height: `${Math.max(2, (d.value / max) * 100)}%` }}\n                />\n                {hover === i ? (\n                  <div className=\"pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 w-40 -translate-x-1/2 rounded-md border border-border bg-popover p-2 text-left text-[11px] shadow-lg\">\n                    <div className=\"mb-1 font-semibold\">{d.label}</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-muted-foreground\">{seriesLabel}</span>\n                      <span className=\"font-semibold tabular-nums\">{fmt(d.value)}</span>\n                    </div>\n                    {typeof d.compare === \"number\" ? (\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-muted-foreground\">{compareLabel}</span>\n                        <span className=\"tabular-nums\">{fmt(d.compare)}</span>\n                      </div>\n                    ) : null}\n                  </div>\n                ) : null}\n              </div>\n            ))}\n          </div>\n          <div className=\"mt-1 flex gap-1.5 border-t border-border pt-1\">\n            {data.map((d) => (\n              <span\n                key={d.label}\n                className=\"flex-1 truncate text-center text-[10px] text-muted-foreground\"\n              >\n                {d.label}\n              </span>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/** Three-column operational inbox layout: list · thread · context. */\nexport function InboxLayout({\n  list,\n  thread,\n  context,\n}: {\n  list: ReactNode;\n  thread: ReactNode;\n  context: ReactNode;\n}) {\n  return (\n    <div className=\"grid min-h-[560px] grid-cols-1 gap-2 lg:h-[calc(100vh-250px)] lg:grid-cols-[300px_minmax(0,1fr)_320px]\">\n      <aside className=\"flex min-h-0 flex-col overflow-hidden rounded-md border border-border bg-card\">\n        {list}\n      </aside>\n      <section className=\"flex min-h-0 flex-col overflow-hidden rounded-md border border-border bg-card\">\n        {thread}\n      </section>\n      <aside className=\"flex min-h-0 flex-col overflow-y-auto rounded-md border border-border bg-card\">\n        {context}\n      </aside>\n    </div>\n  );\n}\n\nexport function useLocalToggle(initial = false) {\n  return useState(initial);\n}\n\n/* ------------------------------------------------------------------ */\n/* Navigation definitions                                              */\n/* ------------------------------------------------------------------ */\n\nexport const SELLER_NAV: NavItem[] = [\n  { to: \"/seller/manager\", label: \"Dashboard\" },\n  {\n    to: \"/seller/catalog\",\n    label: \"Products\",\n    children: [\n      { to: \"/seller/catalog\", label: \"My products\" },\n      { to: \"/seller/products\", label: \"Live catalog (real data)\" },\n      { to: \"/seller/inventory\", label: \"Inventory\" },\n    ],\n  },\n  {\n    to: \"/seller/order-desk\",\n    label: \"Orders\",\n    children: [\n      { to: \"/seller/order-desk\", label: \"Order desk\" },\n      { to: \"/seller/orders\", label: \"Live orders (real data)\" },\n      { to: \"/seller/quotes\", label: \"Manual quotes\" },\n    ],\n  },\n  {\n    to: \"/seller/questions\",\n    label: \"Customers\",\n    children: [\n      { to: \"/seller/questions\", label: \"Customer questions\" },\n      { to: \"/seller/messages\", label: \"Messages with Borvat\" },\n      { to: \"/seller/reviews\", label: \"Reviews\" },\n    ],\n  },\n  {\n    to: \"/seller/shipping\",\n    label: \"Operations\",\n    children: [\n      { to: \"/seller/shipping\", label: \"Shipping & delivery\" },\n      { to: \"/seller/inventory\", label: \"Inventory\" },\n      { to: \"/seller/performance\", label: \"Service standards\" },\n    ],\n  },\n  {\n    to: \"/seller/promotions\",\n    label: \"Growth\",\n    children: [\n      { to: \"/seller/promotions\", label: \"Promotions\" },\n      { to: \"/seller/advertising\", label: \"Advertising\" },\n      { to: \"/seller/suggestions\", label: \"Suggestions\" },\n    ],\n  },\n  { to: \"/seller/finances\", label: \"Finance\" },\n  {\n    to: \"/seller/analysis\",\n    label: \"Analytics\",\n    children: [\n      { to: \"/seller/analysis\", label: \"Sales analysis\" },\n      { to: \"/seller/performance\", label: \"Performance\" },\n    ],\n  },\n  {\n    to: \"/seller/settings\",\n    label: \"Settings\",\n    children: [\n      { to: \"/seller/onboarding\", label: \"Onboarding & verification\" },\n      { to: \"/seller/settings\", label: \"Shop settings\" },\n      { to: \"/seller/store\", label: \"Store profile\" },\n      { to: \"/seller/stores\", label: \"All shops\" },\n    ],\n  },\n];\n\nexport const ADMIN_NAV: NavItem[] = [\n  { to: \"/admin/dashboard\", label: \"Dashboard\" },\n  {\n    to: \"/admin/companies\",\n    label: \"Merchants\",\n    children: [\n      { to: \"/admin/companies\", label: \"Companies\" },\n      { to: \"/admin/stores\", label: \"Stores\" },\n      { to: \"/admin/seller-applications\", label: \"Seller applications\" },\n      { to: \"/admin/users\", label: \"Users\" },\n    ],\n  },\n  {\n    to: \"/admin/products\",\n    label: \"Catalog\",\n    children: [\n      { to: \"/admin/products\", label: \"Listings\" },\n      { to: \"/admin/listings\", label: \"Draft listings\" },\n    ],\n  },\n  { to: \"/admin/orders\", label: \"Orders\" },\n  { to: \"/admin/shipping\", label: \"Shipping\" },\n  { to: \"/admin/quotes\", label: \"Manual quotes\" },\n  { to: \"/admin/support\", label: \"Support\" },\n  { to: \"/admin/security\", label: \"Security\" },\n  { to: \"/admin/channels\", label: \"Integrations\" },\n  { to: \"/admin/audit\", label: \"Audit\" },\n  { to: \"/admin/health\", label: \"Platform health\" },\n];\n\nexport const SUPPORT_NAV: NavItem[] = [\n  { to: \"/support/queue\", label: \"Case queue\" },\n  { to: \"/support/inbox/customers\", label: \"Customer inbox\" },\n  { to: \"/support/inbox/merchants\", label: \"Merchant inbox\" },\n  { to: \"/support/cases/case_1001\", label: \"Case workspace\" },\n];\n","usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/demo/skeleton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/product-card.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/product-form.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/review/seller-applications-panel.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/site-header.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/scratch/ece77f5f97ff/oss-evaluation/critical-path/borvat-typed/src/components/ui/a