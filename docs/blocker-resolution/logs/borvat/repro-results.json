{
  "lint": {
    "command": [
      "node",
      "node_modules/eslint/bin/eslint.js",
      ".",
      "--fix",
      "--format",
      "json"
    ],
    "exit": 1
  },
  "typecheck": {
    "command": [
      "node",
      "node_modules/typescript/bin/tsc",
      "--noEmit"
    ],
    "exit": 0
  },
  "build": {
    "command": [
      "node",
      "node_modules/vite/bin/vite.js",
      "build"
    ],
    "exit": 1
  }
}