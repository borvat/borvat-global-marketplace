{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["../../apps/marketplace/src/*"]
    }
  },
  "include": [
    "main.tsx",
    "../../apps/marketplace/src/components/commercial/**/*.tsx",
    "../../apps/marketplace/src/lib/commercial/**/*.ts",
    "tests/**/*.tsx"
  ]
}
