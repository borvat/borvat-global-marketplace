# BORVAT Marketplace - environment template
# Copy to .env and fill in locally. Never commit real values.

# Administrative connection: owns schema, runs migrations. Never used by the API.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/borvat_dev

# Application connection: subject to row level security. This is what the API uses.
APP_DATABASE_URL=postgres://borvat_app:CHANGE_ME@127.0.0.1:5432/borvat_dev

# HTTP
PORT=8080
API_HOST=0.0.0.0

# Platform settings
PLATFORM_COUNTRY=NL
PLATFORM_CURRENCY=EUR
DEFAULT_COMMISSION_BPS=1200

# Session lifetime in seconds
SESSION_TTL_SECONDS=604800