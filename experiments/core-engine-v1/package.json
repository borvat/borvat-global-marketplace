{
  "name": "borvat-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BORVAT Global Marketplace - multi-vendor commerce core (real, runnable, PostgreSQL-backed)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/migrate.ts --reset",
    "seed": "tsx src/db/seed.ts",
    "api": "tsx src/http/server.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
