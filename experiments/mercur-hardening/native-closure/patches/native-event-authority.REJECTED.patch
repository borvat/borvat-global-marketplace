diff --git a/packages/core/src/utils/authorize-native-event.ts b/packages/core/src/utils/authorize-native-event.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/src/utils/authorize-native-event.ts
@@ -0,0 +1,10 @@
+import { MedusaError } from '@medusajs/framework/utils'
+import { MedusaContainer } from '@medusajs/framework/types'
+export type NativeEventAuthority = { assert(event: unknown, subscriber: string): Promise<void> }
+// Mandatory trusted producer authority; never infer actor/company from job payload.
+// Adopters must register a persisted resolver. Missing registration is fail-closed.
+export async function authorizeNativeEvent(container: MedusaContainer, event: unknown, subscriber: string) {
+ const authority = container.resolve<NativeEventAuthority>('suroohNativeEventAuthority', {allowUnregistered:true})
+ if (!authority) throw new MedusaError(MedusaError.Types.NOT_ALLOWED, 'NATIVE_EVENT_AUTHORITY_REQUIRED')
+ await authority.assert(event, subscriber)
+}
