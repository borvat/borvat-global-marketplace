{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BORVAT Shopping Intent v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "nl",
        "en"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "market": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$"
    },
    "budget": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "maxMinor"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "maxMinor": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "requestedBundle": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept",
          "quantity"
        ],
        "properties": {
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "maxItems": 30
    },
    "deliveryDeadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sortPriority": {
      "enum": [
        "lowest_total",
        "fastest_eligible",
        "best_match"
      ]
    }
  },
  "required": [
    "locale",
    "query",
    "market",
    "budget",
    "requestedBundle",
    "deliveryDeadline",
    "sortPriority"
  ]
}
